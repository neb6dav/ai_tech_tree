id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=neurosymbolic"},"tree:recordType":"atlasEntry","tree:startYear":2019,"tree:endYear":2019,"tree:dateLabel":"2019","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-symbolic"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aneurosymbolic%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aneurosymbolic%3AmapStatus"}],"tree:claimFingerprint":"327baf78"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-gap_neurosym","@type":["schema:DefinedTerm","prov:Entity","tree:OpenResearchDirection"],"schema:identifier":"gap_neurosym","schema:name":"Symbolic rigor at LLM scale","schema:description":"Research direction: combine broad language-model capabilities with end-to-end formal verification. Current systems demonstrate verified reasoning in bounded mathematics and code settings; broad coverage remains unresolved.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=gap_neurosym"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2504.21801"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2602.18307"}],"tree:recordType":"atlasEntry","tree:startYear":2026,"tree:endYear":2026,"tree:dateLabel":"2026","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-symbolic"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-g"},"tree:legacyClassificationCode":"g","tree:legacyClassificationLabel":"Open direction","tree:kind":"open_direction","tree:significance":"not_assessed","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_neurosym%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_neurosym%3AmapStatus"}],"tree:researchQuestion":["Can a system retain broad language-model coverage while making its consequential inferences machine-checkable?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_neurosym%3E2504.21801"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_neurosym%3E2602.18307"}],"tree:claimFingerprint":"e14b8ff1","tree:directionClaimState":"editorial_hypothesis","tree:directionAsOf":"2026-08-04","tree:directionConfidence":"high","tree:closureCriteria":"On a predeclared suite spanning mathematics, repository-scale software verification, and structured domain rules, report proof coverage, proof-check success, residual unverified claims, abstentions, and capability loss relative to an otherwise matched unconstrained model.","tree:partialResult":["DeepSeek-Prover-V2 demonstrates strong formal mathematics performance in Lean 4.","LeanDojo and ReProver make retrieval-augmented theorem proving reproducible at laboratory scale.","VeriSoftBench shows that mathematics-specialized provers transfer poorly to dependency-rich software repositories."],"tree:starterProject":["Individual: Build a proof-coverage auditor for a 7B prover on LeanDojo and VeriSoftBench that separates verified conclusions, unsupported premises, failed proofs, and timeouts.","Small lab: Train and evaluate one prover across mathematics and repository-scale software, explicitly measuring transfer loss and dependency-retrieval failures.","Well-funded lab: Develop a proof-carrying general assistant whose high-consequence outputs compile into multiple formal backends, with calibrated abstention when formalization is incomplete."],"tree:counterexample":["DeepSeek-Prover-V2-671B reports 88.9 percent on MiniF2F and solves 49 of 658 PutnamBench problems.","LeanDojo and ReProver provide open data, tooling, retrieval, and a 98,734-theorem benchmark.","FormalMATH, Leanabell-Prover-V2, and Lean Copilot provide additional narrow formal-reasoning systems."],"tree:crowdedness":"High in formal mathematics and medium in cross-domain verification.","tree:tractability":"High for benchmark and tooling work; low for broad end-to-end verification.","tree:noveltyReview":{"@value":{"status":"targeted_search","checkedAt":"2026-08-04","scope":"arXiv and official repositories for neural theorem proving, Lean, proof-carrying generation, repository-scale software verification, and neuro-symbolic reasoning.","note":"Formal mathematics is a strong and crowded subfield, but broad cross-domain machine-checkable inference remains incomplete; no priority claim is made."},"@type":"@json"},"tree:researchResources":{"@value":{"benchmarks":["MiniF2F","PutnamBench","ProverBench","FormalMATH","ProofNet","TheoremBench","LeanDojo benchmark","VeriSoftBench"],"code":["https://github.com/deepseek-ai/DeepSeek-Prover-V2","https://github.com/lean-dojo/LeanDojo","https://github.com/lean-dojo/ReProver","https://github.com/utopia-group/VeriSoftBench","https://github.com/leanprover-community/mathlib4"],"datasets":["LeanDojo theorem and premise annotations","VeriSoftBench repository-context obligations","FormalMATH and mathlib4"],"estimated":{"individual":"1 x 24-48 GB GPU plus Lean for inference and auditing","smallLab":"8 x 80 GB GPUs for verifier training over several weeks","wellFundedLab":"64-256 accelerators for large proof search and cross-domain training"}},"@type":"@json"}},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-shannonchess","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"shannonchess","schema:name":"Shannon's chess blueprint","schema:description":"'Programming a Computer for Playing Chess': minimax plus evaluation functions. The founding document of game AI.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=shannonchess"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#work-shannon-chess-1950"}],"tree:recordType":"atlasEntry","tree:startYear":1950,"tree:endYear":1950,"tree:dateLabel":"1950","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-search"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-f"},"tree:legacyClassificationCode":"f","tree:legacyClassificationLabel":"Foundational","tree:kind":"development","tree:significance":"foundational","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Ashannonchess%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Ashannonchess%3AmapStatus"}],"tree:landmarkWorkAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#work-link-shannonchess%3Eshannon-chess-1950"}],"tree:claimFingerprint":"1215b16a"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-minimaxab","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"minimaxab","schema:name":"Alpha–beta & heuristic search","schema:description":"Pruning cut game trees exponentially; heuristic evaluation made search practical. The workhorse of classical AI.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=minimaxab"},"tree:recordType":"atlasEntry","tree:startYear":1958,"tree:endYear":1958,"tree:dateLabel":"1958","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-search"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-f"},"tree:legacyClassificationCode":"f","tree:legacyClassificationLabel":"Foundational","tree:kind":"development","tree:significance":"foundational","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aminimaxab%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aminimaxab%3AmapStatus"}],"tree:claimFingerprint":"20295f31"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-astar","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"astar","schema:name":"A* search","schema:description":"Optimal pathfinding with admissible heuristics, built for Shakey. In every router, game engine and planner since.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=astar"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#work-hart-nilsson-raphael-astar-1968"}],"tree:recordType":"atlasEntry","tree:startYear":1968,"tree:endYear":1968,"tree:dateLabel":"1968","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-search"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a5