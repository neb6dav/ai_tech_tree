led real-time face detection and were widely deployed in early cameras and vision products; later learned detectors largely displaced the original pipeline.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=facedetect"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#work-viola-jones-cascade-2001"}],"tree:recordType":"atlasEntry","tree:startYear":2001,"tree:endYear":2001,"tree:dateLabel":"2001","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-vision"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-f"},"tree:legacyClassificationCode":"f","tree:legacyClassificationLabel":"Foundational","tree:kind":"development","tree:significance":"foundational","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Afacedetect%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Afacedetect%3AmapStatus"}],"tree:landmarkWorkAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#work-link-facedetect%3Eviola-jones-cascade-2001"}],"tree:claimFingerprint":"466c46d5"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-imagenet","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"imagenet","schema:name":"ImageNet & benchmark culture","schema:description":"14M crowd-labeled images and an annual contest. The dataset that made deep learning measurable — and made benchmarks the field's engine.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=imagenet"},"schema:citation":[{"@id":"urn:uuid:7d0547