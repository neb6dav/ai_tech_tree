":267,"wikipediaSourceReferences":766,"evidenceAssessments":1389,"directionCards":15,"editorialClassifications":7},"@type":"@json"},"tree:evidenceCoverage":{"@value":{"development":{"confirmed":184,"partial":105,"indirect":0,"conflict":0,"not_found":3,"not_assessed":32,"stale":0,"editorial_only":0,"hypothesis":0},"mapStatus":{"confirmed":6,"partial":9,"indirect":0,"conflict":0,"not_found":0,"not_assessed":32,"stale":0,"editorial_only":277,"hypothesis":15},"edges":{"confirmed":6,"partial":3,"indirect":288,"conflict":0,"not_found":214,"not_assessed":164,"stale":0,"editorial_only":0,"hypothesis":36},"nodeAssessed":292,"directionDispositions":15,"statusAssessed":307,"edgeAssessed":511,"nonGapEdgeTotal":667,"gapEdgeTotal":44},"@type":"@json"},"tree:researchSummary":{"@value":{"added":32,"core":24,"specialist":7,"emerging":1,"integrated":52,"guided":71,"papers":176,"paperLinks":186,"landmarkWorks":76,"landmarkLinks":76,"publicDomainWorks":4,"linkedNodes":163,"directionCards":15},"@type":"@json"},"tree:inclusionCriterion":["Historically influential concepts, systems or results","Developments needed to make a major lineage legible","Landmark papers, books, theses and reports that make a major lineage directly readable; selected 2010-2026 ArXiv work that fills a documented map gap","Open directions framed with a falsifiable or decision-relevant closure test"],"tree:knownLimitation":["Curated, not exhaustive or peer reviewed","English-language and English-Wikipedia bias","Selected rather than systematic literature coverage; landmark links prioritize stable, authoritative access","Industrial work may be missing because results are private or poorly documented","Priority and influence claims can be disputed","Some ArXiv-sourced additions and extension relationships have no completed Wikipedia review; exact coverage is reported in the evidence summary","A map terminal means only that this edition records no downstream link","Network positions are generated from recorded associations; spatial proximity is not evidence of chronology, importance, similarity, consensus or causality"],"tree:changeNote":["Repaired the first-minute map orientation with a curated, display-only 24-node anchor set and 72-relationship spine.","Exposed primary navigation across desktop and tablet layouts and added a compact mobile start chooser.","Renamed reader-facing relationship controls to Connections and Related without changing URL compatibility.","Simplified previews and reader-facing guidance while preserving the complete methodology under Help.","Separated relationship meaning from evidence strength","Separated significance, activity and trajectory facets","Added reviewed ranges and disclosed nonlinear spacing","Added structured cards for every open direction","Added list view, visible-fit, empty-state recovery and modal focus containment","Removed data-derived HTML injection sinks and added single-file security metadata","Added synchronized JSON-LD, JSON and NDJSON knowledge-graph exports with stable identifiers.","Reserved a branch-label rail, added scale-aware grouped overview markers, and removed the redundant footer statistics strip.","Anchored composite developments by their start year, repaired the Markov chronology, and added a rights-labeled landmark-reading graph for canonical papers and books.","Added a centered, versioned first-visit guide with an optional left dock, action-labeled theme switching, and verified two-theme contrast.","Made the docked guide a reserved left column so branch, era, timeline, list, empty-state and map text remain unobscured.","Added a deterministic, evidence-aware 2-D Network view with synchronized selection, filters, theme, trace and share state.","Packaged the atlas as a collaborative public-beta repository with citation, licensing, correction and contribution workflows.","Published stable Opportunity endpoints and root application record URLs with compatibility paths.","Added an exact staged-build manifest and persistent repository and contribution access."],"@graph":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-roots","@type":"schema:DefinedTerm","schema:identifier":"roots","schema:name":"ROOTS · MATH, NEURO & CYBERNETICS","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"tree:recordType":"lane"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-symbolic","@type":"schema:DefinedTerm","schema:identifier":"symbolic","schema:name":"SYMBOLIC AI & KNOWLEDGE","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"tree:recordType":"lane"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-search","@type":"schema:DefinedTerm","schema:identifier":"search","schema:name":"SEARCH, PLANNING & GAMES","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"tree:recordType":"lane"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-rl","@type":"schema:DefinedTerm","schema:identifier":"rl","schema:name":"REINFORCEMENT LEARNING & AGENTS","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"tree:recordType":"lane"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-neural","@type":"schema:DefinedTerm","schema:identifier":"neural","schema:name":"NEURAL ARCHITECTURES","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"tree:recordType":"lane"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-training","@type":"schema:DefinedTerm","schema:identifier":"training","schema:name":"TRAINING, SCALE & EFFICIENCY","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"tree:recordType":"lane"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-language","@type":"schema:DefinedTerm","schema:identifier":"language","schema:name":"LANGUAGE & LLMs","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"tree:recordType":"lane"},{"@id":"urn:uuid:7d054