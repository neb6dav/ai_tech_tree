":"Adversarial examples","schema:description":"Imperceptible perturbations that fool networks. A decade of attack–defense arms race — unsolved, now mostly managed rather than fixed.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=advexamples"},"tree:recordType":"atlasEntry","tree:startYear":2014,"tree:endYear":2014,"tree:dateLabel":"2014","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-safety"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aadvexamples%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aadvexamples%3AmapStatus"}],"tree:claimFingerprint":"883a20db"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-interp","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"interp","schema:name":"Early interpretability (saliency→circuits)","schema:description":"Feature visualization, attribution maps, Olah's circuits program. From pretty pictures toward an actual science of what networks compute.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=interp"},"tree:recordType":"atlasEntry","tree:startYear":2013,"tree:endYear":2020,"tree:dateLabel":"2013-2020","tree:chronologyMilestone":["Neural saliency and feature visualization 2013-2014","Circuits program 2020"],"tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a