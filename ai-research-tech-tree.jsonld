":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=ssm"},"tree:recordType":"atlasEntry","tree:startYear":2021,"tree:endYear":2023,"tree:dateLabel":"2021-2023","tree:chronologyMilestone":["S4 2021","Mamba 2023"],"tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-neural"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Assm%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Assm%3AmapStatus"}],"tree:claimFingerprint":"bc2b8b44"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-titans","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"titans","schema:name":"Test-time memory (Titans)","schema:description":"Architectures whose weights update while running — nested learning against frozen-model amnesia. The architectural frontier of 2025–26.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=titans"},"tree:recordType":"atlasEntry","tree:startYear":2025,"tree:endYear":2025,"tree:dateLabel":"2025","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-neural"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-h"},"tree:legacyClassificationCode":"h","tree:legacyClassificationLabel":"Hot frontier","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"high_activity","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Atitans%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Atitans%3AmapStatus"}],"tree:claimFingerprint":"f1186e3a"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-gap_energyllm","@type":["schema:DefinedTerm","prov:Entity","tree:OpenResearchDirection"],"schema:identifier":"gap_energyllm","schema:name":"Energy-based LMs at scale","schema:description":"Research direction: compare energy-based, diffusion-language-model and JEPA-style non-autoregressive systems with strong autoregressive baselines at equal data, parameter, inference-compute and latency budgets. Capable 8B-14B non-autoregressive systems already exist; robust parity across broad language tasks, efficiency and controllability remains unresolved.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=gap_energyllm"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2507.02092"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2606.25331"}],"tree:recordType":"atlasEntry","tree:startYear":2026,"tree:endYear":2026,"tree:dateLabel":"2026","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-neural"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-g"},"tree:legacyClassificationCode":"g","tree:legacyClassificationLabel":"Open direction","tree:kind":"open_direction","tree:significance":"not_assessed","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_energyllm%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_energyllm%3AmapStatus"}],"tree:researchQuestion":["Can a genuinely energy-based or non-autoregressive language objective match the strongest autoregressive models under equal data, parameters, training compute, and serving budgets across capability, efficiency, and controllability?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_energyllm%3E2507.02092"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_energyllm%3E2606.25331"}],"tree:claimFingerprint":"b8e32acc","tree:directionClaimState":"editorial_hypothesis","tree:directionAsOf":"2026-08-04","tree:directionConfidence":"medium","tree:closureCriteria":"Run a preregistered scaling study with shared data, tokenizer, parameter and FLOP budgets, followed by matched-quality serving comparisons across capability, latency, throughput, controllability, and calibration.","tree:partialResult":["Energy-Based Transformers learn compatibility energies and perform inference through energy minimization.","iLLaDA is an 8B masked-diffusion language model trained on 12 trillion tokens and is competitive with Qwen2.5-7B on several benchmarks.","LLaDA, SEDD, and Nemotron-Labs-Diffusion demonstrate scalable non-autoregressive or hybrid alternatives."],"tree:starterProject":["Individual: Benchmark released autoregressive, diffusion, and energy-based checkpoints under matched answer quality, reporting latency, function evaluations, memory, and controllable infilling.","Small lab: Train matched 300M-1B autoregressive, masked-diffusion, and energy-based models on one frozen corpus and publish complete learning and serving curves.","Well-funded lab: Run a preregistered 7B-14B matched-data scaling trial including instruction tuning, code, reasoning, long-form generation, and production-serving cost."],"tree:counterexample":["Energy-Based Transformers directly instantiate an energy-based language architecture.","LLaDA and iLLaDA show that masked diffusion can scale to 8B parameters and trillions of tokens.","Nemotron-Labs-Diffusion releases 3B, 8B, and 14B hybrid autoregressive-diffusion models.","SEDD reports competitive discrete-diffusion language modeling at smaller scale."],"tree:crowdedness":"High and increasing across diffusion, energy-based, and hybrid language modeling.","tree:tractability":"Medium for controlled small-scale studies and low for genuine frontier parity.","tree:noveltyReview":{"@value":{"status":"targeted_search","checkedAt":"2026-08-04","scope":"arXiv and official repositories for energy-based transformers, discrete diffusion, masked language diffusion, joint-embedding prediction, and large non-autoregressive language models.","note":"Large partial systems exist, so the defensible gap is exact equal-budget broad parity rather than absence of scale; diffusion models are adjacent and should not all be labeled energy-based."},"@type":"@json"},"tree:researchResources":{"@value":{"benchmarks":["WikiText-103 perplexity","MMLU","ARC-Challenge","HellaSwag","BBH","GSM8K","MATH","HumanEval","MBPP","IFEval"],"code":["https://github.com/alexiglad/EBT","https://github.com/ML-GSAI/LLaDA","https://github.com/louaaron/Score-Entropy-Discrete-Diffusion","https://github.com/NVlabs/Nemotron-Labs-Diffusion"],"datasets":["WikiText-103","OpenWebText","Controlled FineWeb or FineWeb-Edu subsets","LM1B"],"estimated":{"individual":"Released 3B-8B model evaluation on 1 x 48-80 GB GPU for several days","smallLab":"300M-1B matched training on 8 x 80 GB GPUs for 1-3 weeks","wellFundedLab":"7B-14B matched training on 64-256 accelerators for multiple weeks"}},"@type":"@json"}},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-sgd","@type":["schema:DefinedTerm","prov:Entity","