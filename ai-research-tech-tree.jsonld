ics"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-h"},"tree:legacyClassificationCode":"h","tree:legacyClassificationLabel":"Hot frontier","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"high_activity","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Avisuomotor%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Avisuomotor%3AmapStatus"}],"tree:researchTier":"core","tree:tag":["robotics","imitation learning","generative models"],"tree:researchQuestion":["How can generative robot policies handle long horizons, contact-rich recovery and distribution shift outside demonstrations?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-visuomotor%3E2303.04137"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-visuomotor%3E2304.13705"}],"tree:claimFingerprint":"120a17b2"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-modelediting","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"modelediting","schema:name":"Model editing & activation steering","schema:description":"Targeted weight edits and inference-time activation interventions can change facts or behaviors locally. Reliability, side effects, causal interpretation and generalization remain active limitations.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=modelediting"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2202.05262"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2308.10248"},{"@id":"urn:uuid:7d0547f2