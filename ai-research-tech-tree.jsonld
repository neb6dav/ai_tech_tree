1c866#paper-link-materials%3E2312.03687"}],"tree:claimFingerprint":"16358c91"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-fusion","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"fusion","schema:name":"Plasma & fusion control","schema:description":"Deep RL shaping tokamak plasmas (TCV). Control physics by learning — a template for AI in big experimental science.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=fusion"},"tree:recordType":"atlasEntry","tree:startYear":2022,"tree:endYear":2022,"tree:dateLabel":"2022","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-science"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Afusion%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Afusion%3AmapStatus"}],"tree:claimFingerprint":"33e2f97c"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-mathai","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"mathai","schema:name":"AI mathematics (IMO gold)","schema:description":"AlphaGeometry reached Olympiad-level geometry in 2024, while AlphaProof and AlphaGeometry 2 achieved silver-medal-equivalent IMO performance that year; later 2025 systems reported gold-level results.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=mathai"},"tree:recordType":"atlasEntry","tree:startYear":2024,"tree:endYear":2024,"tree:dateLabel":"2024","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-science"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-h"},"tree:legacyClassificationCode":"h","tree:legacyClassificationLabel":"Hot frontier","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"high_activity","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Amathai%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Amathai%3AmapStatus"}],"tree:claimFingerprint":"ebc27d83"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-medicine","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"medicine","schema:name":"Medical AI deployment","schema:description":"Radiology assist → clinical LLMs (Med-Gemini class). Regulation, liability and workflow — not accuracy — are now the rate limiters. Watson's failure is the syllabus.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=medicine"},"tree:recordType":"atlasEntry","tree:startYear":2023,"tree:endYear":2023,"tree:dateLabel":"2023","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-science"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Amedicine%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Amedicine%3AmapStatus"}],"tree:claimFingerprint":"6b181329"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-genomics","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"genomics","schema:name":"Genomics models (AlphaGenome, Evo)","schema:description":"Long-context models reading regulatory DNA and whole genomes. The genome as a language — the next AlphaFold-shaped bet.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=genomics"},"tree:recordType":"atlasEntry","tree:startYear":2025,"tree:endYear":2025,"tree:dateLabel":"2025","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-science"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agenomics%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agenomics%3AmapStatus"}],"tree:claimFingerprint":"cea76724"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-sciagents","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"sciagents","schema:name":"AI co-scientists","schema:description":"Agentic hypothesis, literature and experiment pipelines have produced reported algorithmic and scientific results in bounded domains. Independent reproduction and research-integrity practice are still developing.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=sciagents"},"tree:recordType":"atlasEntry","tree:startYear":2025,"tree:endYear":2025,"tree:dateLabel":"2025","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-science"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-h"},"tree:legacyClassificationCode":"h","tree:legacyClassificationLabel":"Hot frontier","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"high_activity","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Asciagents%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Asciagents%3AmapStatus"}],"tree:claimFingerprint":"8c9c682f"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-gap_scilab","@type":["schema:DefinedTerm","prov:Entity","tree:OpenResearchDirection"],"schema:identifier":"gap_scilab","schema:name":"General-purpose autonomous scientist","schema:description":"Domain-specific self-driving laboratories already close design–execute–learn loops. The open challenge is reliable, reproducible autonomy that forms hypotheses and transfers across instruments, domains and scientific objectives.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=gap_scilab"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2602.20669"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2504.08066"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-1906.05398"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2101.07385"}],"tree:recordType":"atlasEntry","tree:startYear":2026,"tree:endYear":2026,"tree:dateLabel":"2026","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-science"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-g"},"tree:legacyClassificationCode":"g","tree:legacyClassificationLabel":"Open direction","tree:kind":"open_direction","tree:significance":"not_assessed","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_scilab%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_scilab%3AmapStatus"}],"tree:researchTier":"integrated","tree:tag":["open direction","science","robotics"],"tree:researchQuestion":["Can one autonomous scientific system transfer across instruments and scientific domains while keeping experiments safe, uncertainty calibrated, provenance complete, and results independently reproducible?","Which parts of scientific judgment transfer across domains, and how should autonomous labs document uncertainty and failed experiments?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_scilab%3E2602.20669"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_scilab%3E2504.08066"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_scilab%3E1906.05398"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_scilab%3E2101.07385"}],"tree:claimFingerprint":"2b251c42","tree:directionClaimState":"editorial_hypothesis","tree:directionAsOf":"2026-08-04","tree:directionConfidence":"high","tree:closureCriteria":"Pre-register transfer from at least one training domain or instrument to two materially different targets; require calibrated abstention and human safety gates; preserve machine-readable lineage from hypothesis through raw data and analysis; compare against domain-specific automation and human teams; and have an independent lab reproduce a claimed result from the released record.","tree:partialResult":["A 2026 autonomous laboratory agent operates scanning probe microscopy through a domain-specific model and deterministic modular interface. AI Scientist-v2 automates computational machine-learning research across several subdomains, and earlier Coscientist work demonstrated bounded chemistry workflows. These systems establish real partial autonomy, but none closes cross-instrument, cross-domain transfer with independent physical reproduction and calibrated uncertainty."],"tree:starterProject":["Individual: Build a provenance-first agent for DiscoveryBench and ScienceAgentBench that must produce an executable rerun bundle, calibrated confidence, and an explicit abstention whenever evidence or permissions are missing.","Small lab: Connect the same policy layer to two instruments, or one instrument plus a high-fidelity simulator, preregister transfer tasks, retain human safety approval, and have a second operator independently repeat the result.","Well-funded lab: Run a two-domain, two-site autonomous-science challenge with different instruments, robotic sample handling, blind replication, machine-readable lineage, uncertainty calibration, and independent safety and research-integrity oversight."],"tree:counterexample":["Autonomous Laboratory Agent controls real-time atomic-resolution scanning probe microscopy using a customized domain model, deterministic validation, and modular orchestration; it remains a single instrument family and domain.","AI Scientist-v2 performs template-free computational ML research and produced workshop-level manuscripts, including one accepted at a workshop with a high acceptance rate; it does not demonstrate transfer across physical instruments or independent experimental reproduction.","Coscientist and other self-driving-lab systems demonstrate chemistry and materials workflows, while DiscoveryBench and ScienceAgentBench show that broad data-science agents still solve only a minority of realistic tasks."],"tree:crowdedness":"High for computational science agents, medium for domain-specific self-driving labs, and low for the same system transferring across physical domains and sites.","tree:tractability":"High for data-only provenance studies, medium for a single-instrument system, and low for cross-domain transfer with independent physical reproduction.","tree:noveltyReview":{"@value":{"status":"targeted_search","checkedAt":"2026-08-04","scope":"Targeted arXiv searches for autonomous laboratories, self-driving labs, AI scientists, laboratory agents, cross-domain scientific agents, instrument control, reproducibility, provenance, Coscientist, AI Scientist v2, and 2025-2026 systems and benchmarks; reference chaining from representative systems and benchmark papers.","note":"High confidence that transferable cross-instrument, cross-domain autonomy with independent physical replication remains open. Domain-specific and computational systems are already substantial, so the gap must not be described as absence of autonomous science. No priority claim is made."},"@type":"@json"},"tree:researchResources":{"@value":{"benchmarks":["ScienceAgentBench","DiscoveryBench","A preregistered cross-instrument protocol with an independent physical reproduction endpoint"],"code":["https://github.com/DIAOZHUO/LLM-directed-SPM","https://github.com/SakanaAI/AI-Scientist-v2","https://github.com/allenai/discoverybench","https://github.com/snap-stanford/MLAgentBench"],"datasets":["DiscoveryBench","ScienceAgentBench and LAB-Bench","Open Reaction Database and Materials Project for cross-domain data work, plus raw instrument traces and complete experiment lineage"],"estimated":{"individual":"One to four GPUs and data-only or simulated laboratories; no unsupervised wet-lab or physical actuation.","smallLab":"Four to sixteen GPUs, two API-controlled instruments or one instrument plus simulator, technician time, metrology, and safety review.","wellFundedLab":"Thirty-two or more GPUs, two domains and multiple workcells, robotic sample handling, instrument engineers, metrology, research-integrity controls, and an independent replication site."}},"@type":"@json"}},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-subword","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"subword","schema:name":"Subword tokenization (BPE → SentencePiece)","schema:description":"Open-vocabulary modeling with reusable word pieces made rare words, multilingual translation and modern LLM vocabularies practical. The quiet interface between raw text and neural sequence models.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=subword"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-1508.07909"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-1808.06226"}],"tree:recordType":"atlasEntry","tree:startYear":2015,"tree:endYear":2018,"tree:dateLabel":"2015-2018","tree:chronologyMilestone":["Subword NMT 2015","SentencePiece 2018"],"tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-language"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-f"},"tree:legacyClassificationCode":"f","tree:legacyClassificationLabel":"Foundational","tree:kind":"development","tree:significance":"foundational","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Asubword%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Asubword%3AmapStatus"}],"tree:researchTier":"core","tree:tag":["language","data","systems"],"tree:researchQuestion":["Can learned or token-free representations improve multilingual efficiency without destabilizing training?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-subword%3E1508.07909"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-subword%3E1808.06226"}],"tree:claimFingerprint":"072495e6"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-modelleak","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"modelleak","schema:name":"Privacy attacks & model leakage","schema:description":"Membership inference and related attacks showed that trained models can reveal whether specific records — and sometimes sensitive attributes — were present. Privacy became an empirical attack surface, not only a training objective.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=modelleak"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-1610.05820"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2012.07805"}],"tree:recordType":"atlasEntry","tree:startYear":2016,"tree:endYear":2016,"tree:dateLabel":"2016","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-safety"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Amodelleak%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Amodelleak%3AmapStatus"}],"tree:researchTier":"core","tree:tag":["privacy","security","evaluation"],"tree:researchQuestion":["How can leakage be measured and mitigated under realistic black-box access without hiding behind average-case metrics?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-modelleak%3E1610.05820"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-modelleak%3E2012.07805"}],"tree:claimFingerprint":"c716c087"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-oodshift","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"oodshift","schema:name":"Distribution shift & OOD detection","schema:description":"Models can be confidently wrong when deployment data differs from training. Detection baselines, shift benchmarks and robustness methods made this a distinct reliability field rather than an edge case.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=oodshift"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-1610.02136"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2012.07421"}],"tree:recordType":"atlasEntry","tree:startYear":2016,"tree:endYear":2016,"tree:dateLabel":"2016","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-safety"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aoodshift%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aoodshift%3AmapStatus"}],"tree:researchTier":"core","tree:tag":["reliability","evaluation","safety"],"tree:researchQuestion":["Can systems recognize consequential distribution shift without labels and abstain without crippling useful coverage?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-oodshift%3E1610.02136"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-oodshift%3E2012.07421"}],"tree:claimFingerprint":"0a315603"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-imitation","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"imitation","schema:name":"Modern imitation learning (DAgger → GAIL)","schema:description":"DAgger confronted policy-induced distribution shift; GAIL learned behavior by adversarially matching expert demonstrations. Together they formed the modern route from demonstrations to sequential policies.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=imitation"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-1011.0686"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-1606.03476"}],"tree:recordType":"atlasEntry","tree:startYear":2011,"tree:endYear":2016,"tree:dateLabel":"2011-2016","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#la