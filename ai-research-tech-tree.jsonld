 a proven impossibility.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=capsules"},"tree:recordType":"atlasEntry","tree:startYear":2017,"tree:endYear":2017,"tree:dateLabel":"2017","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-neural"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-x"},"tree:legacyClassificationCode":"x","tree:legacyClassificationLabel":"Ended / superseded (legacy)","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"not_assessed","tree:trajectory":"ambiguous_ended_or_superseded","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Acapsules%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Acapsules%3AmapStatus"}],"tree:claimFingerprint":"cf470a4d"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-neuralode","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"neuralode","schema:name":"Neural ODEs","schema:description":"Neural networks parameterize continuous-time dynamics solved by differential-equation methods. Adoption is specialized but active in time series, control, scientific machine learning, and continuous normalizing flows.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=neuralode"},"tree:recordType":"atlasEntry","tree:startYear":2018,"tree:endYear":2018,"tree:dateLabel":"2018","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-neural"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:lega