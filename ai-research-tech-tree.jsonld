c for taxonomies; became OWL. Industrial ontology work persists; the research frontier moved on.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=dlogic"},"tree:recordType":"atlasEntry","tree:startYear":1991,"tree:endYear":1991,"tree:dateLabel":"1991","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-symbolic"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-d"},"tree:legacyClassificationCode":"d","tree:legacyClassificationLabel":"Dormant","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"dormant","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Adlogic%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Adlogic%3AmapStatus"}],"tree:claimFingerprint":"0b62acb1"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-fuzzy","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"fuzzy","schema:name":"Fuzzy logic","schema:description":"Zadeh's graded truth. Ran 80s–90s consumer devices (cameras, rice cookers, trains), then drifted out of core AI research entirely.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=fuzzy"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#work-zadeh-fuzzy-sets-1965"}],"tree:recordType":"atlasEntry","tree:startYear":1965,"tree:endYear":1965,"tree:dateLabel":"1965","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-symbolic"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-d"},"tree:legacyCl