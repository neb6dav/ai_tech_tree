81"}],"tree:claimFingerprint":"523b032c"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-optimaltransport","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"optimaltransport","schema:name":"Computational optimal transport","schema:description":"Entropic regularization made transport distances computationally practical; Wasserstein objectives then influenced generative modeling, domain adaptation and representation learning.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=optimaltransport"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-1306.0895"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-1701.07875"}],"tree:recordType":"atlasEntry","tree:startYear":2013,"tree:endYear":2013,"tree:dateLabel":"2013","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-prob"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aoptimaltransport%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aoptimaltransport%3AmapStatus"}],"tree:researchTier":"specialist","tree:tag":["probability","geometry","generative models"],"tree:researchQuestion":["Can transport objectives scale without sacrificing geometry, sample quality or numerical stability?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-opti