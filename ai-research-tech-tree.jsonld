t ran out before LLMs arrived.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=friendlyai"},"tree:recordType":"atlasEntry","tree:startYear":2001,"tree:endYear":2001,"tree:dateLabel":"2001","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-safety"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-d"},"tree:legacyClassificationCode":"d","tree:legacyClassificationLabel":"Dormant","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"dormant","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Afriendlyai%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Afriendlyai%3AmapStatus"}],"tree:claimFingerprint":"46198135"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-superintbook","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"superintbook","schema:name":"'Superintelligence' (Bostrom)","schema:description":"Orthogonality, instrumental convergence, the treacherous turn. Made existential risk respectable in policy and tech circles.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=superintbook"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#work-bostrom-superintelligence-2014"}],"tree:recordType":"atlasEntry","tree:startYear":2014,"tree:endYear":2014,"tree:dateLabel":"2014","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-safety"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-f"},"tree:legacyClassificationCode