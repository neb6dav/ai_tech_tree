e Cog and ASIMO era. Those programs ended without general intelligence; humanoid research returned decades later through modern control and learned foundation models.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=cog"},"tree:recordType":"atlasEntry","tree:startYear":1993,"tree:endYear":1993,"tree:dateLabel":"1993","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-robotics"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-x"},"tree:legacyClassificationCode":"x","tree:legacyClassificationLabel":"Ended / superseded (legacy)","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"not_assessed","tree:trajectory":"ambiguous_ended_or_superseded","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Acog%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Acog%3AmapStatus"}],"tree:claimFingerprint":"fb43447d"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-alvinn","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"alvinn","schema:name":"ALVINN drives (1989)","schema:description":"A neural net steering a van from camera pixels at CMU. Imitation learning's proof of concept, three decades early.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=alvinn"},"tree:recordType":"atlasEntry","tree:startYear":1989,"tree:endYear":1989,"tree:dateLabel":"1989","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-robotics"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-f"},"tree:legacyClassi