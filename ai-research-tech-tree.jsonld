jectory":"ambiguous_ended_or_superseded","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Asuperalign%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Asuperalign%3AmapStatus"}],"tree:claimFingerprint":"5d92fed6"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-w2s","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"w2s","schema:name":"Scalable oversight & weak-to-strong","schema:description":"Can weaker judges reliably train stronger models? The successor question once human feedback saturates — alignment's next hard problem.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=w2s"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2305.20050"}],"tree:recordType":"atlasEntry","tree:startYear":2023,"tree:endYear":2023,"tree:dateLabel":"2023","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-safety"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aw2s%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aw2s%3AmapStatus"}],"tree:researchTier":"integrated","tree:tag":["alignment","oversight","evaluation"],"tree:researchQuestion":["What feedback remains trustworthy when the model is more capable than its evaluator?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-w2s%3E2305.20050"}],"tree:claimFingerprint":"ae65985d"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-evals","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"evals","schema:name":"Evals & red-teaming discipline","schema:description":"METR, AISIs, dangerous-capability evals, model cards. Measuring what models can do became its own research field — and the science is young.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=evals"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-1810.03993"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-1803.09010"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2403.13793"}],"tree:recordType":"atlasEntry","tree:startYear":2023,"tree:endYear":2023,"tree:dateLabel":"2023","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-safety"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-h"},"tree:legacyClassificationCode":"h","tree:legacyClassificationLabel":"Hot frontier","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"high_activity","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aevals%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aevals%3AmapStatus"}],"tree:researchTier":"integrated","tree:tag":["evaluation","safety","governance"],"tree:researchQuestion":["Which evaluations predict costly real-world behavior rather than benchmark-specific competence?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-evals%3E1810.03993"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-evals%3E1803.09010"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-evals%3E2403.13793"}],"tree:claimFingerprint":"59d622be"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-govern","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"govern","schema:name":"Governance era (EU AI Act, AISIs)","schema:description":"Law arrives: compute thresholds, transparency duties, incident reporting, safety institutes. Research and regulation now co-evolve.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=govern"},"tree:recordType":"atlasEntry","tree:startYear":2023,"tree:endYear":2023,"tree:dateLabel":"2023","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-safety"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agovern%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agovern%3AmapStatus"}],"tree:claimFingerprint":"e5ad8359"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-provablysafe","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"provablysafe","schema:name":"Guaranteed-safe AI","schema:description":"Formal world-models and proof-carrying AI (Tegmark–Russell program). Aspiration far ahead of tooling — a program waiting for its methods.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=provablysafe"},"tree:recordType":"atlasEntry","tree:startYear":2023,"tree:endYear":2023,"tree:dateLabel":"2023","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-safety"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-d"},"tree:legacyClassificationCode":"d","tree:legacyClassificationLabel":"Dormant","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"dormant","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aprovablysafe%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aprovablysafe%3AmapStatus"}],"tree:claimFingerprint":"7baabdec"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-gap_interp","@type":["schema:DefinedTerm","prov:Entity","tree:OpenResearchDirection"],"schema:identifier":"gap_interp","schema:name":"Reliable interpretability-based control","schema:description":"Model editing and activation steering can change local facts and behaviors. Still missing: scalable, predictable interventions grounded in causal understanding, with robust generalization and meaningful guarantees.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=gap_interp"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2501.17148"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2301.04213"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2202.05262"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2308.10248"}],"tree:recordType":"atlasEntry","tree:startYear":2026,"tree:endYear":2026,"tree:dateLabel":"2026","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-safety"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-g"},"tree:legacyClassificationCode":"g","tree:legacyClassificationLabel":"Open direction","tree:kind":"open_direction","tree:significance":"not_assessed","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_interp%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_interp%3AmapStatus"}],"tree:researchTier":"integrated","tree:tag":["open direction","interpretability","control"],"tree:researchQuestion":["Can interpretability methods support ex ante predictions of durable model-control interventions, including composition, persistence, and bounded side effects across models and tasks?","Which causal abstractions support interventions that stay reliable across prompts, tasks and model updates?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_interp%3E2501.17148"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_interp%3E2301.04213"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_interp%3E2202.05262"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_interp%3E2308.10248"}],"tree:claimFingerprint":"3cfc8485","tree:directionClaimState":"editorial_hypothesis","tree:directionAsOf":"2026-08-04","tree:directionConfidence":"high","tree:closureCriteria":"Before applying each intervention, predict its target effect, collateral effects, interactions with other interventions, and persistence after additional training or context shifts; beat non-mechanistic baselines across multiple model families and seeds; and reproduce the prediction-to-control mapping independently.","tree:partialResult":["Activation steering, representation engineering, sparse autoencoders, causal tracing, and model editing can alter behavior. AxBench finds simple prompting and fine-tuning baselines often beat sparse-autoencoder steering, while localization-versus-editing studies show that causal localization does not reliably identify the best place to edit. Early 2026 work predicts some steering side effects, but results remain method-, dictionary-, and model-dependent."],"tree:starterProject":["Individual: On two open small models, use AxBench and CounterFact to predict target and collateral changes before each intervention, then publish calibration curves and all failed predictions.","Small lab: Build a cross-model, cross-seed challenge spanning prompting, fine-tuning, steering, sparse autoencoders, and editing, with tests of intervention composition and persistence after additional training.","Well-funded lab: Run a blinded, preregistered intervention tournament across model families in which one team predicts effects, another executes interventions, and an independent group evaluates hidden targets and side effects."],"tree:counterexample":["AxBench provides a broad steering benchmark and finds prompting strongest overall, supervised fine-tuning next, and sparse autoencoders often uncompetitive; it is evidence both of controllability and of weak mechanistic advantage.","Causal localization can identify behaviorally relevant components, yet the localization-versus-editing study finds it does not consistently predict the most effective edit layer.","Recent work predicts some sparse-autoencoder steering side effects before intervention, but generalization varies across models, dictionaries, and target concepts."],"tree:crowdedness":"High; mechanistic interpretability and steering are crowded, but preregistered prediction-to-control and independent replication are less common.","tree:tractability":"High for bounded falsification studies, medium for cross-model predictive rules, and low for durable general guarantees.","tree:noveltyReview":{"@value":{"status":"targeted_search","checkedAt":"2026-08-04","scope":"Targeted arXiv searches for mechanistic interpretability interventions, activation and representation steering, sparse-autoencoder steering, knowledge editing, causal localization, intervention side-effect prediction, SAEBench, AxBench, and 2025-2026 benchmark audits; reference chaining from the representative studies.","note":"High confidence that predictable, durable, composable control with bounded side effects remains open. There are meaningful local successes, so the claim is deliberately about calibrated ex ante prediction across methods and models, not whether interventions ever work. No priority claim is made."},"@type":"@json"},"tree:researchResources":{"@value":{"benchmarks":["AxBench","SAEBench","CounterFact plus neighborhood tests and MQuAKE-style multi-hop edits"],"code":["https://github.com/stanfordnlp/axbench","https://github.com/stanfordnlp/pyvene","https://github.com/kmeng01/rome","https://github.com/jbloomAus/SAELens"],"datasets":["AxBench concept datasets and feature dictionaries","CounterFact and ZsRE","MQuAKE or an equivalent compositional-edit set"],"estimated":{"individual":"One 24-80 GB GPU for 0.5B-8B open models, depending on intervention and activation storage.","smallLab":"Four to sixteen GPUs across several 7B-70B models, methods, and random seeds.","wellFundedLab":"Thirty-two or more GPUs, multiple independently developed model families, blinded evaluation, and an external replication team."}},"@type":"@json"}},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-gap_agents","@type":["schema:DefinedTerm","prov:Entity","tree:OpenResearchDirection"],"schema:identifier":"gap_agents","schema:name":"Provable agent boundaries","schema:description":"Research direction: develop testable containment, permission and corrigibility guarantees for tool-using agents under realistic interfaces and adversarial conditions.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=gap_agents"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2312.06942"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2406.13352"}],"tree:recordType":"atlasEntry","tree:startYear":2026,"tree:endYear":2026,"tree:dateLabel":"2026","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-safety"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-g"},"tree:legacyClassificationCode":"g","tree:legacyClassificationLabel":"Open direction","tree:kind":"open_direction","tree:significance":"not_assessed","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_agents%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_agents%3AmapStatus"}],"tree:researchQuestion":["Can enforceable least-privilege and containment policies for adaptive tool-using agents survive realistic prompt injection, delegation, persistence, privilege escalation, and sandbox-escape attacks?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_agents%3E2312.06942"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_agents%3E2406.13352"}],"tree:claimFingerprint":"d79af32a","tree:directionClaimState":"editorial_hypothesis","tree:directionAsOf":"2026-08-04","tree:directionConfidence":"high","tree:closureCriteria":"Specify the policy and threat model formally; enforce it below the model layer; test benign utility and adaptive attacks across real tool classes, delegation, memory, restart, identity, network, and code execution; show bounded failure probability under repeated trials; and obtain an independent penetration test.","tree:partialResult":["AI Control shows that monitoring and protocol design can improve safety even when an untrusted model intentionally subverts a coding task. AgentDojo and Agent Security Bench provide realistic tool-agent prompt-injection and security suites, while SandboxEscapeBench tests container-escape capability. These are substantial defenses and measurements, but none establishes general containment under an adaptive real-tool threat model."],"tree:starterProject":["Individual: Add a deny-by-default, provenance-aware least-privilege wrapper to AgentDojo and compare it with prompt-only defenses on both benign utility and adaptive indirect prompt injection.","Small lab: Combine AgentDojo, Agent Security Bench, and sandbox-escape tasks in gVisor or Firecracker; red-team delegation, memory, restart, exfiltration, and privilege transitions across four model families.","Well-funded lab: Build an isolated replica of a real enterprise tool environment with formal identity, network, filesystem, and approval policies; commission independent model red teaming and a conventional penetration test."],"tree:counterexample":["AI Control demonstrates that trusted monitoring, auditing, and protocol design improve outcomes against an intentionally subversive untrusted coding model, within a bounded backdoor-insertion setting.","AgentDojo contains 97 benign tasks and 629 security test cases across four tool domains; tested agents and defenses still trade off utility and security.","Agent Security Bench spans ten scenarios, more than 400 tools, and roughly 90,000 tests, while SandboxEscapeBench adds realistic container-escape tasks; neither alone proves containment."],"tree:crowdedness":"High for empirical agent security and prompt injection; lower for formal, below-model enforcement tested against adaptive end-to-end attacks.","tree:tractability":"High for benchmark and least-privilege improvements, medium for robust production patterns, and very low for broad formal containment guarantees.","tree:noveltyReview":{"@value":{"status":"targeted_search","checkedAt":"2026-08-04","scope":"Targeted arXiv searches for AI control, agent containment, agent security benchmarks, prompt injection, capability control, least privilege, tool authorization, container escape, adaptive red teaming, and 2024-2026 follow-on work; reference chaining from AI Control, AgentDojo, ASB, and SandboxEscapeBench.","note":"High confidence that enforceable containment surviving adaptive attacks in realistic tool environments remains open. Empirical defenses and control protocols are active and valuable, so the claim is not that no defenses exist. No universal impossibility or priority claim is made."},"@type":"@json"},"tree:researchResources":{"@value":{"benchmarks":["AgentDojo","Agent Security Bench","SandboxEscapeBench or ControlArena"],"code":["https://github.com/ethz-spylab/agentdojo","https://github.com/agiresearch/ASB","https://github.com/google/gvisor","https://github.com/firecracker-microvm/firecracker"],"datasets":["AgentDojo's 629 security cases and 97 utility tasks","Agent Security Bench's approximately 90,000 tests","Versioned sandbox-escape scenarios and complete tool, policy, and authorization traces"],"estimated":{"individual":"One workstation, containerized tools, and one or two local or API models; no live secrets or production accounts.","smallLab":"Four to eight model families, hardened microVM infrastructure, security engineering, and an adaptive red team.","wellFundedLab":"Isolated replicas of real tools and identity systems, kernel and network specialists, formal-policy expertise, independent penetration testing, and incident-response capacity."}},"@type":"@json"}},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-moore","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"moore","schema:name":"Moore's law","schema:description":"Transistor counts double every ~2 years. The metronome under every AI wave — and every winter's eventual thaw.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=moore"},"tree:recordType":"atlasEntry","tree:startYear":1965,"tree:endYear":1965,"tree:dateLabel":"1965","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-systems"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-f"},"tree:legacyClassificationCode":"f","tree:legacyClassificationLabel":"Foundational","tree:kind":"development","tree:significance":"foundational","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Amoore%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Amoore%3AmapStatus"}],"tree:claimFingerprint":"175adc73"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-internetdata","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"internetdata","schema:name":"The web as dataset","schema:description":"Crawls, Wikipedia, forums, Common Crawl. Humanity accidentally wrote its own training corpus.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=internetdata"},"tree:recordType":"atlasEntry","tree:startYear":1998,"tree:endYear":1998,"tree:dateLabel":"1998","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-systems"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-f"},"tree:legacyClassificationCode":"f","tree:legacyClassificationLabel":"Foundational","tree:kind":"development","tree:significance":"foundational","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Ainternetdata%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Ainternetdata%3AmapStatus"}],"tree:claimFingerprint":"0bbd4126"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-mturk","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"mturk","schema:name":"Crowd labeling (MTurk)","schema:description":"Human annotation at industrial scale — made ImageNet possible, and prefigured today's RLHF data industry.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=mturk"},"tree:recordType":"atlasEntry","tree:startYear":2005,"tree:endYear":2005,"tree:dateLabel":"2005","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-systems"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-f"},"tree:legacyClassificationCode":"f","tree:legacyClassificationLabel":"Foundational","tree:kind":"development","tree:significance":"foundational","tree:activity":"not_assessed","tree:trajectory"