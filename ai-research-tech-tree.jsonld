node=catforget"},"tree:recordType":"atlasEntry","tree:startYear":1989,"tree:endYear":1989,"tree:dateLabel":"1989","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-training"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-f"},"tree:legacyClassificationCode":"f","tree:legacyClassificationLabel":"Foundational","tree:kind":"development","tree:significance":"foundational","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Acatforget%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Acatforget%3AmapStatus"}],"tree:claimFingerprint":"172cdb88"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-relu","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"relu","schema:name":"ReLU, dropout & practical depth","schema:description":"Two cheap tricks — sparse activations, random deletion — made deep nets trainable without pretraining scaffolds. Simplicity beat cleverness.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=relu"},"tree:recordType":"atlasEntry","tree:startYear":2011,"tree:endYear":2011,"tree:dateLabel":"2011","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-training"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-f"},"tree:legacyClassificationCode":"f","tree:legacyClassificationLabel":"Foundational","tree:kind":"development","tree:significance":"foundational","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree