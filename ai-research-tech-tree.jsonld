#assessment-node%3Allmserving%3AmapStatus"}],"tree:researchTier":"core","tree:tag":["systems","inference","efficiency"],"tree:researchQuestion":["How should serving jointly optimize latency, throughput, memory, energy and tail reliability under heterogeneous workloads?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-llmserving%3E2211.17192"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-llmserving%3E2302.01318"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-llmserving%3E2309.06180"}],"tree:claimFingerprint":"8e177549"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-agentbench","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"agentbench","schema:name":"Interactive agent benchmarks","schema:description":"WebArena, AgentBench, SWE-bench and OSWorld evaluate stateful execution in websites, repositories and computers. They expose planning and recovery failures that static question-answer benchmarks miss.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=agentbench"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2307.13854"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2308.03688"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2310.06770"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2404.07972"}],"tree:recordType":"atlasEntry","tree:startYear":2023,"tree:endYear":2023,"tree:dateLabel":"2023","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-rl"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-h"},"tree:legacyClassificationCode":"h","tree:legacyClassificationLabel":"Hot frontier","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"high_activity","tree:trajectory":"not_assessed","tre