usConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Amead%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Amead%3AmapStatus"}],"tree:claimFingerprint":"eaee37b0"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-reservoir","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"reservoir","schema:name":"Reservoir computing","schema:description":"Fixed random recurrence + trained readout. A clever shortcut that found its ceiling — revived interest wherever physical substrates compute.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=reservoir"},"tree:recordType":"atlasEntry","tree:startYear":2001,"tree:endYear":2001,"tree:dateLabel":"2001","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-alt"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-d"},"tree:legacyClassificationCode":"d","tree:legacyClassificationLabel":"Dormant","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"dormant","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Areservoir%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Areservoir%3AmapStatus"}],"tree:claimFingerprint":"0b6e1359"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-htm","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"htm","schema:name":"Hierarchical Temporal Memory","schema:description":"Hawkins' cortical theory as product (Numenta). Two decades of conviction, minimal ML impact — a parallel track that never merged with the mainline.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=htm"},"tree:recordType":"atlasEntry","tree:startYear":2004,"tree:endYear":2004,"tree:dateLabel":"2004","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-alt"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-x"},"tree:legacyClassificationCode":"x","tree:legacyClassificationLabel":"Ended / superseded (legacy)","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"not_assessed","tree:trajectory":"ambiguous_ended_or_superseded","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Ahtm%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Ahtm%3AmapStatus"}],"tree:claimFingerprint":"bbc15aab"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-dna","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"dna","schema:name":"DNA computing","schema:description":"Adleman demonstrated combinatorial computation in DNA. General-purpose molecular computing remains niche, while adjacent DNA data-storage and biosensing research continues.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=dna"},"tree:recordType":"atlasEntry","tree:startYear":1994,"tree:endYear":1994,"tree:dateLabel":"1994","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-alt"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-d"},"tree:legacyClassificationCode":"d","tree:legacyClassificationLabel":"Dormant","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"dormant","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Adna%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Adna%3AmapStatus"}],"tree:claimFingerprint":"2cfa45c3"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-neuromorphic","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"neuromorphic","schema:name":"Neuromorphic chips (Loihi)","schema:description":"TrueNorth, Loihi, SpiNNaker: silicon spikes at microwatts. Research platforms in search of a market for a decade and counting.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=neuromorphic"},"tree:recordType":"atlasEntry","tree:startYear":2014,"tree:endYear":2014,"tree:dateLabel":"2014","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-alt"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-d"},"tree:legacyClassificationCode":"d","tree:legacyClassificationLabel":"Dormant","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"dormant","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aneuromorphic%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aneuromorphic%3AmapStatus"}],"tree:claimFingerprint":"6019c548"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-quantumml","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"quantumml","schema:name":"Quantum machine learning","schema:description":"HHL and variational circuits promised speedups; barren plateaus and dequantization deflated them. No practical ML advantage demonstrated yet.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=quantumml"},"tree:recordType":"atlasEntry","tree:startYear":2014,"tree:endYear":2014,"tree:dateLabel":"2014","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-alt"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-d"},"tree:legacyClassificationCode":"d","tree:legacyClassificationLabel":"Dormant","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"dormant","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aquantumml%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aquantumml%3AmapStatus"}],"tree:claimFingerprint":"66277fde"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-optical","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"optical","schema:name":"Optical neural networks","schema:description":"Optical systems perform neural-network operations using light. Photonic interconnects are nearer-term, while optical compute remains an active research program with continuing 2020s demonstrations.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=optical"},"tree:recordType":"atlasEntry","tree:startYear":2017,"tree:endYear":2017,"tree:dateLabel":"2017","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-alt"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aoptical%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aoptical%3AmapStatus"}],"tree:claimFingerprint":"b592f187"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-analogai","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"analogai","schema:name":"Analog in-memory computing","schema:description":"Compute inside memory cells to escape the von Neumann bottleneck. Real inference chips exist; training precision remains the wall.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=analogai"},"tree:recordType":"atlasEntry","tree:startYear":2020,"tree:endYear":2020,"tree:dateLabel":"2020","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-alt"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aanalogai%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aanalogai%3AmapStatus"}],"tree:claimFingerprint":"c4cf0d79"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-alphaevolve","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"alphaevolve","schema:name":"LLM-guided evolution (AlphaEvolve)","schema:description":"Evolutionary search with LLM mutation operators: new matrix-multiplication records, kernel speedups, open math results. Genetic programming's revenge.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=alphaevolve"},"tree:recordType":"atlasEntry","tree:startYear":2025,"tree:endYear":2025,"tree:dateLabel":"2025","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-alt"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-h"},"tree:legacyClassificationCode":"h","tree:legacyClassificationLabel":"Hot frontier","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"high_activity","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aalphaevolve%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aalphaevolve%3AmapStatus"}],"tree:claimFingerprint":"a647b5c7"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-gap_biolearn","@type":["schema:DefinedTerm","prov:Entity","tree:OpenResearchDirection"],"schema:identifier":"gap_biolearn","schema:name":"Learning without backprop","schema:description":"Research direction: test whether local or biologically plausible learning rules can approach backpropagation at useful scale and map efficiently to neuromorphic or analog hardware.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=gap_biolearn"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2212.13345"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2601.21683"}],"tree:recordType":"atlasEntry","tree:startYear":2026,"tree:endYear":2026,"tree:dateLabel":"2026","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-alt"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-g"},"tree:legacyClassificationCode":"g","tree:legacyClassificationLabel":"Open direction","tree:kind":"open_direction","tree:significance":"not_assessed","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_biolearn%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_biolearn%3AmapStatus"}],"tree:researchQuestion":["Can local learning approach backpropagation at useful scale while delivering a measured hardware, memory, communication, or energy advantage?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_biolearn%3E2212.13345"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_biolearn%3E2601.21683"}],"tree:claimFingerprint":"4ce852f0","tree:directionClaimState":"editorial_hypothesis","tree:directionAsOf":"2026-08-04","tree:directionConfidence":"high","tree:closureCriteria":"On a useful-scale task and matched architecture, a local rule closes most of the accuracy and robustness gap to backpropagation while demonstrating reproducible end-to-end energy, memory, communication, or latency gains that include host and data-movement overhead.","tree:partialResult":["Forward-Forward replaces forward and backward passes with positive and negative forward passes but was introduced on small problems.","CLAPP-like local self-supervised learning matches comparable global objectives on CIFAR-10, STL-10, and Tiny ImageNet.","Predictive coding can approximate backpropagation on arbitrary computation graphs in theory and small implementations."],"tree:starterProject":["Individual: Compare backpropagation, CLAPP, predictive coding, and Forward-Forward on identical Tiny ImageNet networks while measuring stored activations, communication, memory, and accuracy.","Small lab: Scale the strongest local self-supervised rule to ImageNet-100 or ImageNet-1k with matched ResNet or ViT baselines and NeuroBench-style operation metrics.","Well-funded lab: Implement the same local rule on neuromorphic or analog hardware and publish wall-plug energy, latency, robustness, and host-overhead comparisons against a conventional backpropagation system."],"tree:counterexample":["Local CLAPP variants match comparable global self-supervised objectives on several small vision datasets.","Predictive-coding updates can approximate automatic differentiation on arbitrary computation graphs.","Neuromorphic systems show task-specific energy advantages, although often without matched learning rules and end-to-end accounting."],"tree:crowdedness":"Medium across local learning, predictive coding, and neuromorphic computing.","tree:tractability":"High for small-scale algorithmic work and low for credible useful-scale systems claims.","tree:noveltyReview":{"@value":{"status":"targeted_search","checkedAt":"2026-08-04","scope":"arXiv and official repositories for Forward-Forward, predictive coding, local self-supervised learning, neuromorphic learning, and hardware-energy measurement.","note":"Partial algorithmic and hardware results exist, but the search did not find a useful-scale system showing both backpropagation-level performance and end-to-end systems advantage."},"@type":"@json"},"tree:researchResources":{"@value":{"benchmarks":["CIFAR-10","STL-10","Tiny ImageNet","ImageNet-1k","NeuroBench","DVS Gesture","SHD or SSC","Google Speech Commands"],"code":["https://github.com/NeuroBench/neurobench","https://github.com/liukidar/pcx","https://github.com/mpezeshki/pytorch_forward_forward","https://github.com/jeshraghian/snntorch","https://github.com/lava-nc/lava"],"datasets":["CIFAR-10, STL-10, Tiny ImageNet, and ImageNet-1k","DVS Gesture","Spiking Heidelberg Digits and Spiking Speech Commands","Google Speech Commands"],"estimated":{"individual":"1 x 24 GB GPU for 2-5 days","smallLab":"4-8 GPUs plus neuromorphic or FPGA access for 2-4 weeks","wellFundedLab":"32-64 GPUs plus production neuromorphic or analog hardware and calibrated measurement over several months"}},"@type":"@json"}},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-gap_quant","@type":["schema:DefinedTerm","prov:Entity","tree:OpenResearchDirection"],"schema:identifier":"gap_quant","schema:name":"Quantum advantage for learning","schema:description":"Research direction: establish a practically relevant, independently replicated quantum-learning advantage with classical data or explicitly costed quantum-data access. Provable advantages exist under specified access models; practical end-to-end advantage under full resource accounting remains unresolved.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=gap_quant"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2112.00778"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2403.07059"}],"tree:recordType":"atlasEntry","tree:startYear":2026,"tree:endYear":2026,"tree:dateLabel":"2026","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-alt"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-g"},"tree:legacyClassificationCode":"g","tree:legacyClassificationLabel":"Open direction","tree:kind":"open_direction","tree:significance":"not_assessed","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_quant%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_quant%3AmapStatus"}],"tree:researchQuestion":["Can an end-to-end learning workload show a reproducible quantum advantage over the strongest classical alternative after state preparation, data acquisition, error mitigation, wall-clock time, and energy are all counted?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_quant%3E2112.00778"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_quant%3E2403.07059"}],"tree:claimFingerprint":"0c00c4d1","tree:directionClaimState":"editorial_hypothesis","tree:directionAsOf":"2026-08-04","tree:directionConfidence":"high","tree:closureCriteria":"Pre-register the access model, task distribution, hardware, classical comparison budget, and success threshold; include state-preparation, shots, calibration, error mitigation, queue and wall-clock costs; red-team the classical baseline; demonstrate scaling beyond feasible classical replication; and reproduce on independent hardware.","tree:partialResult":["Provable and experimental learning advantages already exist for carefully specified quantum-data access models, including learning from experiments. Broad empirical benchmarking still finds that ordinary classical models usually outperform tested quantum models on classical-data tasks. The defensible open question is practical end-to-end advantage under full resource accounting, not whether any quantum learning advantage has ever been proved."],"tree:starterProject":["Individual: Reproduce selected qml-benchmarks with stronger classical hyperparameter search, identical data splits, and full training and inference timing; publish null results and sensitivity analyses.","Small lab: Implement one learning-from-experiments task on cloud quantum hardware, pre-register the best classical red team, and account for shots, calibration, state preparation, mitigation, transfer, queue, and wall-clock costs.","Well-funded lab: Run the same 30-50-qubit coherent-data learning experiment on two independent hardware stacks, with a separate classical-HPC team and audited time, energy, acquisition, and uncertainty accounting."],"tree:counterexample":["Quantum Advantage in Learning from Experiments proves exponential sample advantages under specified quantum-data access and demonstrates experiments up to 40 superconducting qubits and roughly 1,300 gates; those assumptions do not automatically establish a practical advantage for ordinary classical data.","The qml-benchmarks study evaluates 12 quantum models across 160 datasets grouped into 10 benchmarks and generally finds tuned classical models stronger; simulations were limited to modest qubit counts.","Recent analyses report plausible noisy-qubit separations at tens of qubits, but they are not yet an independently replicated end-to-end hardware advantage with full acquisition and runtime accounting."],"tree:crowdedness":"Medium-high; QML is crowded, while transparent end-to-end cost accounting and adversarial classical baselines remain less common.","tree:tractability":"High for rigorous small-scale benchmarking and valuable negative results; very low for a scalable practical-advantage closure result.","tree:noveltyReview":{"@value":{"status":"targeted_search","checkedAt":"2026-08-04","scope":"Targeted arXiv searches for provable quantum learning advantage, learning from experiments, practical QML advantage, QML benchmarking, noisy-qubit separations, data-loading and state-preparation costs, plus reference chaining from the two representative papers.","note":"High confidence that the practical, fully accounted and independently replicated gap remains open. Existing theory proves advantages under specified access models, so this card makes no blanket no-advantage claim. The review makes no general quantum-supremacy or priority claim."},"@type":"@json"},"tree:researchResources":{"@value":{"benchmarks":["Xanadu qml-benchmarks","ReCirq learning-from-experiments tasks","A preregistered application benchmark with an independently tuned classical red team"],"code":["https://github.com/XanaduAI/qml-benchmarks","https://github.com/quantumlib/ReCirq/tree/master/recirq/qml_lfe","https://github.com/PennyLaneAI/pennylane","https://github.com/qiskit-community/qiskit-machine-learning"],"datasets":["PennyLane QML benchmark datasets","Versioned ReCirq state and dynamics experiment records","Raw shots, calibration snapshots, mitigation settings, and matched classical feature data"],"estimated":{"individual":"CPU/GPU simulation up to roughly 18-24 qubits, depending on circuit and memory, plus classical tuning compute.","smallLab":"Cloud-QPU allocation, HPC simulation, and a separate classical-baseline team.","wellFundedLab":"Reliable access to two 30-50-qubit hardware platforms, low-level experimental support, substantial HPC, and independent replication."}},"@type":"@json"}},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-unimate","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"unimate","schema:name":"Unimate — industrial robots","schema:description":"GM's assembly-line arm. Automation without intelligence — but the hardware lineage AI would eventually inhabit.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=unimate"},"tree:recordType":"atlasEntry","tree:startYear":1961,"tree:endYear":1961,"tree:dateLabel":"1961","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-robotics"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-f"},"tree:legacyClassificationCode":"f","tree:legacyClassificationLabel":"Foundational","tree:kind":"development","tree:significance":"foundational","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aunimate%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aunimate%3AmapStatus"}],"tree:claimFingerprint":"57518006"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-shakey","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"shakey","schema:name":"Shakey","schema:description":"First robot to integrate perception, planning and action; A* and STRIPS were invented for it. Glacial in practice, generative in consequence.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=shakey"},"tree:recordType":"atlasEntry","tree:startYear":1968,"tree:endYear":1968,"tree:dateLabel":"1968","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-robotics"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-f"},"tree:legacyClassificationCode":"f","tree:legacyClassificationLabel":"Foundational","tr