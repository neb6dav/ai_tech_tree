e transformer, 600 tasks, none mastered. Scaling alone didn't cure breadth-without-depth; quietly shelved as LLM agents took the crown.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=gato"},"tree:recordType":"atlasEntry","tree:startYear":2022,"tree:endYear":2022,"tree:dateLabel":"2022","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-rl"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-d"},"tree:legacyClassificationCode":"d","tree:legacyClassificationLabel":"Dormant","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"dormant","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agato%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agato%3AmapStatus"}],"tree:claimFingerprint":"2f813457"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-agentsllm","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"agentsllm","schema:name":"LLM agents & tool use","schema:description":"ReAct→computer use→autonomous coding: language models that act. 2025–26's dominant paradigm — and its reliability problem.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=agentsllm"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2210.03629"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2302.04761"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2303.11366"}],"tree:recordType":"atlasEntry","tree:startYear":2023,"tree:endYear":2023,"tree:dateLabel":"2023","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-rl"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-h"},"tree:legacyClassificationCode":"h","tree:legacyClassificationLabel":"Hot frontier","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"high_activity","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aagentsllm%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aagentsllm%3AmapStatus"}],"tree:researchTier":"integrated","tree:tag":["agents","tools","language"],"tree:researchQuestion":["How should agents plan, recover, maintain state and expose uncertainty across long-running tool use?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-agentsllm%3E2210.03629"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-agentsllm%3E2302.04761"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-agentsllm%3E2303.11366"}],"tree:claimFingerprint":"ec77fef4"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-rlvr","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"rlvr","schema:name":"RL on verifiable rewards","schema:description":"Train reasoning against checkable answers (math, code, proofs). The engine of o1/R1-class models — RL's biggest win since AlphaGo.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=rlvr"},"tree:recordType":"atlasEntry","tree:startYear":2024,"tree:endYear":2024,"tree:dateLabel":"2024","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-rl"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-h"},"tree:legacyClassificationCode":"h","tree:legacyClassificationLabel":"Hot frontier","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"high_activity","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Arlvr%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Arlvr%3AmapStatus"}],"tree:claimFingerprint":"d71d7049"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-gap_openended","@type":["schema:DefinedTerm","prov:Entity","tree:OpenResearchDirection"],"schema:identifier":"gap_openended","schema:name":"Robust, general open-ended self-improvement","schema:description":"Self-generated tasks and self-editing agents now show bounded improvement under human-designed verifiers. Still missing: safe, broadly general, sustained improvement without benchmark gaming, collapse, or a fixed external objective.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=gap_openended"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2505.22954"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2506.10943"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2505.03335"}],"tree:recordType":"atlasEntry","tree:startYear":2026,"tree:endYear":2026,"tree:dateLabel":"2026","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-rl"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-g"},"tree:legacyClassificationCode":"g","tree:legacyClassificationLabel":"Open direction","tree:kind":"open_direction","tree:significance":"not_assessed","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_openended%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_openended%3AmapStatus"}],"tree:researchTier":"integrated","tree:tag":["open direction","agents","safety"],"tree:researchQuestion":["Can an AI system sustain repeated capability improvement across genuinely held-out domains without optimizing a fixed benchmark, depending on a hidden stronger teacher, or accumulating unacceptable safety regressions?","What would count as sustained general improvement rather than benchmark-specific optimization or evaluator exploitation?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_openended%3E2505.22954"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_openended%3E2506.10943"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_openended%3E2505.03335"}],"tree:claimFingerprint":"bade7c8a","tree:directionClaimState":"editorial_hypothesis","tree:directionAsOf":"2026-08-04","tree:directionConfidence":"high","tree:closureCriteria":"Pre-register several improvement cycles and sealed domain families; show statistically reliable gains on newly unsealed tasks after every cycle; compare against static-agent, ordinary fine-tuning, search-only, and human-engineered baselines; publish compute, interventions, failures, contamination checks, and a safety-regression budget; and obtain an independent rerun.","tree:partialResult":["The Darwin Gödel Machine evolves coding-agent implementations and improved bounded software-engineering benchmarks, while SEAL learns its own update directives and training data for bounded adaptation tasks. AlphaEvolve and related verifier-guided systems offer further evidence that self-generated search can improve artifacts. None yet demonstrates safe, durable, domain-general improvement under repeatedly refreshed evaluation."],"tree:starterProject":["Individual: Reproduce one DGM- or SEAL-style update loop on two disjoint small domains, freeze both evaluators before training, and publish every candidate, rollback, cost, and regression.","Small lab: Run a 10-cycle, multi-domain archive experiment with sealed future tasks and compare a static agent, self-editing agent, and diversity-preserving open-ended archive under the same inference and training budget.","Well-funded lab: Conduct a multi-model, long-horizon improvement trial with immutable external evaluations, independent red teaming, automatic rollback, full lineage, and a third-party audit of contamination and safety regressions."],"tree:counterexample":["Darwin Gödel Machine is a concrete self-editing, archive-based coding agent; its gains are on bounded coding benchmarks and one reported run cost about USD 22,000 in API use over roughly two weeks.","SEAL generates its own update directives and fine-tuning data, but evaluates bounded knowledge-incorporation and few-shot tasks rather than indefinite cross-domain improvement.","Search over self-edit strategies and verifier-guided evolutionary systems show useful improvement, while also exposing homogenization, evaluator gaming, and dependence on externally supplied objectives."],"tree:crowdedness":"High for self-improving agents and automated coding; lower for preregistered, repeatedly refreshed, cross-domain and safety-bounded trials.","tree:tractability":"Medium for bounded coding experiments; low for a convincing general and safe long-horizon closure result.","tree:noveltyReview":{"@value":{"status":"targeted_search","checkedAt":"2026-08-04","scope":"Targeted arXiv title-and-abstract searches for open-ended self-improvement, self-editing agents, self-adapting language models, automated coding-agent evolution, verifier-guided evolution, and 2025-2026 follow-on work; primary-paper reference chaining around DGM and SEAL.","note":"High confidence that the narrowed gap remains open. The evidence is strong for bounded self-improvement, but the search found no system satisfying repeated held-out cross-domain improvement, independence from a hidden stronger teacher, and bounded safety regressions together. This is a targeted review, not an exhaustive priority search or a priority claim."},"@type":"@json"},"tree:researchResources":{"@value":{"benchmarks":["SWE-bench Verified plus a sealed post-cutoff issue set","Aider Polyglot with language families held out by cycle","RE-Bench with new, externally authored environments"],"code":["https://github.com/jennyzzt/dgm","https://github.com/Continual-Intelligence/SEAL","https://github.com/princeton-nlp/SWE-bench","https://github.com/METR/RE-Bench"],"datasets":["Frozen SWE-bench repositories and issue snapshots","Aider Polyglot task set","Versioned RE-Bench environments and complete candidate-lineage logs"],"estimated":{"individual":"One to four modern GPUs for local 7B-14B models, or a tightly capped API budget; five to ten update cycles.","smallLab":"Eight to thirty-two GPUs, sandboxed execution, sealed multi-domain evaluations, and an independent evaluator.","wellFundedLab":"Several repeated DGM-scale runs across model families; the DGM paper reports about two weeks and USD 22,000 API cost for one run, before external evaluation and red-team costs."}},"@type":"@json"}},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-perceptron","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"perceptron","schema:name":"Perceptron (Rosenblatt)","schema:description":"Hardware neuron that learned from examples; the Navy promised it would 'walk, talk, see, write.' The hype and the machine that started it all.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=perceptron"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#work-rosenblatt-perceptron-1958"}],"tree:recordType":"atlasEntry","tree:startYear":1958,"tree:endYear":1958,"tree:dateLabel":"1958","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-neural"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-f"},"tree:legacyClassificationCode":"f","tree:legacyClassificationLabel":"Foundational","tree:kind":"development","tree:significance":"foundational","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aperceptron%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aperceptron%3AmapStatus"}],"tree:landmarkWorkAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#work-link-perceptron%3Erosenblatt-perceptron-1958"}],"tree:claimFingerprint":"2469142c"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-adaline","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"adaline","schema:name":"ADALINE & delta rule","schema:description":"Widrow–Hoff gradient learning in analog hardware. LMS still runs in every modem — neural nets' first quiet deployment.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=adaline"},"tree:recordType":"atlasEntry","tree:startYear":1960,"tree:endYear":1960,"tree:dateLabel":"1960","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-neural"},"tree:legacyClassification":{"@id":"ur