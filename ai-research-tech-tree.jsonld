-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=aicontrol"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2312.06942"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2510.09462"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2606.06529"}],"tree:recordType":"atlasEntry","tree:startYear":2023,"tree:endYear":2023,"tree:dateLabel":"2023","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-safety"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-h"},"tree:legacyClassificationCode":"h","tree:legacyClassificationLabel":"Hot frontier","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"high_activity","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aaicontrol%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aaicontrol%3AmapStatus"}],"tree:researchTier":"core","tree:tag":["safety","agents","evaluation"],"tree:researchQuestion":["Which control protocols survive adaptive attacks when trusted monitoring and human audit capacity are scarce?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-aicontrol%3E2312.06942"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-aicontrol%3E2510.09462"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-aicontrol%3E2606.06529"}],"tree:claimFingerprint":"f9e5d01a"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-selfgenagents","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"selfgenagents","schema:name":"Self-generated curricula & self-editing agents","schema:description":"Voyager, Absolute Zero and Darwin Gödel Machine generate tasks, skills or agent modifications and retain measured improvements. Results are promising but bounded by designed environments, verifiers and benchmarks.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=selfgenagents"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2305.16291"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2505.03335"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2505.22954"}],"tree:recordType":"atlasEntry","tree:startYear":2025,"tree:endYear":2025,"tree:dateLabel":"2025","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-rl"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-h"},"tree:legacyClassificationCode":"h","tree:legacyClassificationLabel":"Hot frontier","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"high_activity","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aselfgenagents%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aselfgenagents%3AmapStatus"}],"tree:researchTier":"emerging","tree:tag":["agents","open-endedness","reinforcement learning"],"tree:researchQuestion":["Can improvement remain general, cumulative and safe without a fixed benchmark, hand-designed verifier or hidden human curriculum?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-selfgenagents%3E2305.16291"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-selfgenagents%3E2505.03335"},