":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"hopfield","schema:name":"Hopfield networks","schema:description":"Energy-based associative memory that re-legitimized neural research. Faded for decades — then 'modern Hopfield' math turned out to equal attention. 2024 Nobel.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=hopfield"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#work-hopfield-networks-1982"}],"tree:recordType":"atlasEntry","tree:startYear":1982,"tree:endYear":1982,"tree:dateLabel":"1982","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-neural"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-r"},"tree:legacyClassificationCode":"r","tree:legacyClassificationLabel":"Revived","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"revived","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Ahopfield%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Ahopfield%3AmapStatus"}],"tree:landmarkWorkAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#work-link-hopfield%3Ehopfield-networks-1982"}],"tree:claimFingerprint":"4177f08a"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-boltzmann","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"boltzmann","schema:name":"Boltzmann machines","schema:description":"Stochastic energy models with hidden units. Training pain sidelined them, but their DNA lives in RBMs, energy-based models and diffusion.","schema:inDefinedTermSet":{"@id":"urn:uuid: