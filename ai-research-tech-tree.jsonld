ols?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-txt2img%3E2112.10752"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-txt2img%3E2207.12598"}],"tree:claimFingerprint":"b472a77d"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-dit","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"dit","schema:name":"Diffusion Transformers (DiT)","schema:description":"Transformer backbones gave diffusion models a scalable architecture used across image and increasingly video and audio generation; other backbones remain active.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=dit"},"tree:recordType":"atlasEntry","tree:startYear":2023,"tree:endYear":2023,"tree:dateLabel":"2023","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-generative"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-f"},"tree:legacyClassificationCode":"f","tree:legacyClassificationLabel":"Foundational","tree:kind":"development","tree:significance":"foundational","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Adit%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Adit%3AmapStatus"}],"tree:claimFingerprint":"3f098be1"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-musicgen","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"musicgen","schema:name":"Music & voice generation","schema:description":"Suno, ElevenLabs, voice cloning at consumer scale. Creative industries' negotiation with AI, conducted in real time.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=musicgen"},"tree:recordType":"atlasEntry","tree:startYear":2023,"tree:endYear":2023,"tree:dateLabel":"2023","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-generative"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Amusicgen%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Amusicgen%3AmapStatus"}],"tree:claimFingerprint":"3c3d3e0a"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-video","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"video","schema:name":"Video generation (Sora→Veo 3)","schema:description":"Minutes of coherent video with sound. The live question: are these world simulators in disguise, or very good pixel dreamers?","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=video"},"tree:recordType":"atlasEntry","tree:startYear":2024,"tree:endYear":2025,"tree:dateLabel":"2024-2025","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-generative"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-h"},"tree:legacyClassificationCode":"h","tree:legacyClassificationLabel":"Hot frontier","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"high_activity","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Avideo%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Avideo%3AmapStatus"}],"tree:claimFingerprint":"bbff1f95"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-genie","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"genie","schema:name":"Interactive world models (Genie 3)","schema:description":"Playable, promptable generated worlds. Games and training grounds for agents — a possible road to spatial intelligence (World Labs' Marble, too).","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=genie"},"tree:recordType":"atlasEntry","tree:startYear":2024,"tree:endYear":2024,"tree:dateLabel":"2024","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-generative"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-h"},"tree:legacyClassificationCode":"h","tree:legacyClassificationLabel":"Hot frontier","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"high_activity","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agenie%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agenie%3AmapStatus"}],"tree:claimFingerprint":"711cd671"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-gap_dreamtrain","@type":["schema:DefinedTerm","prov:Entity","tree:OpenResearchDirection"],"schema:identifier":"gap_dreamtrain","schema:name":"Robots trained in dreamed worlds","schema:description":"Research direction: test whether policies trained predominantly in learned generative worlds can outperform matched classical-simulation baselines across multiple physical settings and embodiments. Learned-world-to-real policy loops already exist; robust general transfer remains unresolved.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=gap_dreamtrain"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2511.07416"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2606.31101"}],"tree:recordType":"atlasEntry","tree:startYear":2026,"tree:endYear":2026,"tree:dateLabel":"2026","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-generative"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-g"},"tree:legacyClassificationCode":"g","tree:legacyClassificationLabel":"Open direction","tree:kind":"open_direction","tree:significance":"not_assessed","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_dreamtrain%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_dreamtrain%3AmapStatus"}],"tree:researchQuestion":["Can policies learned mainly inside learned generative world models transfer reliably to multiple physical settings and embodiments, and outperform classical simulation under the same real-world data and compute budget?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_dreamtrain%3E2511.07416"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_dreamtrain%3E2606.31101"}],"tree:claimFingerprint":"987d90ec","tree:directionClaimState":"editorial_hypothesis","tree:directionAsOf":"2026-08-04","tree:directionConfidence":"medium","tree:closureCriteria":"Pre-register at least three tasks, two physical settings, and two embodiments; hold real-world interaction budgets equal; compare learned-world, classical simulator, mixed, imitation-only, and direct-real-training baselines; report intervention and failure rates; and reproduce the result at an independent site.","tree:partialResult":["PhysWorld reconstructs task-specific physical worlds from generated videos and trains residual policies that transfer to real manipulation; 2026 world-action-model work transfers synthetic priors to a Franka arm without real demonstrations on four tasks. DayDreamer, Cosmos Policy, DreamGen, and Gen2Act establish adjacent learned-world or generative-policy loops. These are important counterexamples to the old claim that the loop does not exist, but they do not yet establish robust multi-setting, multi-embodiment superiority over strong classical simulation."],"tree:starterProject":["Individual: In LIBERO or RoboCasa, train a policy from a learned video/world model and a classical physics simulator using identical synthetic trajectories, then evaluate both on the same held-out visual and dynamics shifts.","Small lab: Use one physical arm for three manipulation tasks and two scene shifts; cap real interactions and compare learned-world, domain-randomized simulator, mixed, and imitation baselines with blinded success scoring.","Well-funded lab: Run a preregistered multi-embodiment, multi-site transfer study with equal real-data budgets, safety cages, independent replication, and a full accounting of generation, reconstruction, simulation, and policy-training compute."],"tree:counterexample":["PhysWorld reports an average 82 percent success versus a 67 percent zero-shot baseline across its open-world manipulation evaluation, using generated task video and physical reconstruction; scope and simulator fidelity remain limiting factors.","Efficient Sim-to-Real Transfer of World-Action Models from Synthetic Priors reports about 800 synthetic demonstrations per task and 35 percent average Franka success over four tasks with no real demonstrations, but does not prove that the world-action model is necessary or better than a matched classical simulator.","DayDreamer learns online on physical robots, and Cosmos Policy performs strongly on standard manipulation suites, but neither is a clean demonstration of multi-embodiment policies trained mainly in dreamed worlds."],"tree:crowdedness":"High for robot world models and generative policies; medium for controlled learned-world versus classical-simulator comparisons across physical settings.","tree:tractability":"Medium in simulation, medium-low for one physical arm, and low for independent multi-embodiment closure.","tree:noveltyReview":{"@value":{"status":"targeted_search","checkedAt":"2026-08-04","scope":"Targeted arXiv searches for physical world models, generative simulation, world-action models, synthetic-prior sim-to-real, robot policies from generated video, Dreamer/DayDreamer, Cosmos Policy, and 2025-2026 embodied transfer papers; primary-paper reference chaining.","note":"Medium confidence that the narrowed robust-transfer gap remains open. Existing learned-world-to-real loops narrow the question to multi-setting, multi-embodiment performance under equal budgets. This was a targeted, not exhaustive, priority search."},"@type":"@json"},"tree:researchResources":{"@value":{"benchmarks":["LIBERO","RoboCasa","CALVIN or SIMPLER with predefined real-to-sim correspondence"],"code":["https://github.com/NVIDIA/cosmos","https://github.com/danijar/daydreamer","https://github.com/Lifelong-Robot-Learning/LIBERO"],"datasets":["Open X-Embodiment","DROID","BridgeData V2"],"estimated":{"individual":"One to four high-memory GPUs and simulation-only evaluation.","smallLab":"Eight to thirty-two GPUs, one instrumented robot arm, replacement parts, and several weeks of supervised physical trials.","wellFundedLab":"Sixty-four or more GPUs, multiple robot embodiments and sites, motion capture and safety infrastructure, plus an independent replication team."}},"@type":"@json"}},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-stats25","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"stats25","schema:name":"Statistical inference (Fisher; Bayes)","schema:description":"Maximum likelihood, hypothesis testing, the Bayes–Laplace tradition. The bedrock mathematics machine learning repeatedly rediscovers.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=stats25"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#work-bayes-essay-1763"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#work-fisher-statistical-methods-1925"}],"tree:recordType":"atlasEntry","tree:startYear":1925,"tree:endYear":1925,"tree:dateLabel":"1925","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-prob"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-f"},"tree:legacyClassificationCode":"f","tree:legacyClassificationLabel":"Foundational","tree:kind":"development","tree:significance":"foundational","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Astats25%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Ast