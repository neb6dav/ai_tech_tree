nts, possibly — the plumbing decides what agents can safely do.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=mcp"},"tree:recordType":"atlasEntry","tree:startYear":2024,"tree:endYear":2024,"tree:dateLabel":"2024","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-systems"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-h"},"tree:legacyClassificationCode":"h","tree:legacyClassificationLabel":"Hot frontier","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"high_activity","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Amcp%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Amcp%3AmapStatus"}],"tree:claimFingerprint":"da91442a"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-inferecon","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"inferecon","schema:name":"Inference economics","schema:description":"Serving, caching, routing, token pricing: the cost curve that decides what actually deploys. Where systems research meets business model.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=inferecon"},"tree:recordType":"atlasEntry","tree:startYear":2024,"tree:endYear":2024,"tree:dateLabel":"2024","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-systems"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-h"},"tree:legacyClassificationCode":"h","tree:legacyClassificationLabel":"Hot frontier","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"high_activity","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Ainferecon%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Ainferecon%3AmapStatus"}],"tree:claimFingerprint":"1af12b8b"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-energy","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"energy","schema:name":"Energy & datacenter buildout","schema:description":"Gigawatt campuses, nuclear PPAs, grid politics. AI's growth curve collided with physical infrastructure — the binding constraint after chips.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=energy"},"tree:recordType":"atlasEntry","tree:startYear":2024,"tree:endYear":2024,"tree:dateLabel":"2024","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-systems"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aenergy%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aenergy%3AmapStatus"}],"tree:claimFingerprint":"5cbe0fb1"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-alphachip","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"alphachip","schema:name":"AI designs chips (AlphaChip)","schema:description":"RL placement shipping in production TPUs. The ouroboros: AI improving the hardware that trains AI.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=alphachip"},"tree:recordType":"atlasEntry","tree:startYear":2021,"tree:endYear":2021,"tree:dateLabel":"2021","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-systems"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aalphachip%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aalphachip%3AmapStatus"}],"tree:claimFingerprint":"94650b74"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-gap_data","@type":["schema:DefinedTerm","prov:Entity","tree:OpenResearchDirection"],"schema:identifier":"gap_data","schema:name":"Post-data-wall learning","schema:description":"Research direction: sustain capability improvement under a constrained or synthetic-only data supply while preventing collapse, contamination and diversity loss. Collapse is not inevitable when real-data anchors or external diversity controls remain; the stricter synthetic-only capability ratchet remains unresolved.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=gap_data"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2305.17493"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2404.01413"}],"tree:recordType":"atlasEntry","tree:startYear":2026,"tree:endYear":2026,"tree:dateLabel":"2026","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-systems"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-g"},"tree:legacyClassificationCode":"g","tree:legacyClassificationLabel":"Open direction","tree:kind":"open_direction","tree:significance":"not_assessed","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_data%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_data%3AmapStatus"}],"tree:researchQuestion":["Can repeated generations of synthetic or self-generated experience preserve or improve held-out capability and diversity without fresh human data, contamination, or a hidden stronger teacher?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_data%3E2305.17493"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_data%3E2404.01413"}],"tree:claimFingerprint":"0370d4ff","tree:directionClaimState":"editorial_hypothesis","tree:directionAsOf":"2026-08-04","tree:directionConfidence":"medium","tree:closureCriteria":"Run multiple recursive generations with immutable held-out human evaluations and provenance; measure average quality, tail coverage, diversity, calibration, memorization, and contamination each round; forbid fresh human data and undisclosed stronger-teacher labels after initialization; compare replacement, accumulation, curation, multi-teacher, and self-training regimes; and reproduce independently.","tree:partialResult":["Recursive replacement with generated data can erase distribution tails and cause model collapse. Accumulating synthetic data with the original real distribution can avoid collapse in several modalities, and diverse or pluralistic curation can stabilize bounded regimes. These are genuine counterexamples to inevitability, but they retain real-data anchors, external rewards, multiple teachers, or bounded tasks and do not yet show a sustained synthetic-only capability ratchet."],"tree:starterProject":["Individual: Train a 100M-1B model for 10-20 recursive rounds under replacement, accumulation, and diversity-curation conditions using one cryptographically frozen human holdout and complete data lineage.","Small lab: Run a 1B-8B text or multimodal study for 10-30 rounds, auditing contamination, rare-skill retention, diversity, calibration, and teacher dependence with external evaluators fixed before training.","Well-funded lab: Run a 70B-scale, 30-generation multi-teacher experiment with no fresh human data after initialization, immutable external evaluation, explicit teacher-capability accounting, and an independent provenance and contamination audit."],"tree:counterexample":["The Curse of Recursion demonstrates progressive loss of distribution tails when generated data replace real data across language and generative-model settings.","Is Model Collapse Inevitable? shows that accumulating synthetic data alongside the original real data avoids collapse in language, molecular, and image experiments; this does not satisfy a no-fresh-anchor synthetic-only loop.","Recent curated, diverse-teacher, and pluralistic-reward systems can delay or prevent collapse in bounded settings, but depend on external selection signals, anchored data, or stronger and diverse teachers."],"tree:crowdedness":"High; synthetic data, self-training, and model collapse are active topics, but deeply controlled multi-generation studies remain expensive and less common.","tree:tractability":"High for causal small-model studies, medium for 1B-8B replication, and low for frontier-scale conclusions.","tree:noveltyReview":{"@value":{"status":"targeted_search","checkedAt":"2026-08-04","scope":"Targeted arXiv searches for model collapse, recursive synthetic-data training, synthetic-data accumulation, curated synthetic data, pluralistic rewards, multi-teacher self-training, contamination, experience generation, and 2025-2026 recursive-loop studies; reference chaining from the two representative papers.","note":"Medium confidence that the synthetic-only, repeated capability-improvement gap remains open. Real-data accumulation or externally preserved diversity can prevent collapse in bounded settings; the unresolved target therefore excludes fresh anchors and hidden stronger teachers. No priority claim is made."},"@type":"@json"},"tree:researchResources":{"@value":{"benchmarks":["DataComp-LM or DCLM controlled-data protocol","HELM or lm-evaluation-harness with immutable post-cutoff tasks","A shared recursive train-generate benchmark reporting tail coverage, diversity, calibration, and contamination by generation"],"code":["https://github.com/mlfoundations/dclm","https://github.com/EleutherAI/lm-evaluation-harness","https://github.com/allenai/open-instruct"],"datasets":["DCLM baseline or FineWeb-Edu with full manifests","Dolma","A cryptographically frozen held-out human corpus and provenance ledger not exposed to the generation loop"],"estimated":{"individual":"One to four GPUs for 100M-1B models over 5-20 rounds.","smallLab":"Sixteen to sixty-four GPUs for 1B-8B models, 10-30 rounds, and continuous provenance and contamination analysis.","wellFundedLab":"Frontier-scale training allocation for 70B or multimodal recursive loops, long-term dataset storage, and an independent data-audit team."}},"@type":"@json"}},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-alphafold","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"alphafold","schema:name":"AlphaFold 2","schema:description":"AlphaFold 2 achieved near-experimental accuracy on many CASP14 protein-structure targets, and the AlphaFold Database expanded access to more than 200 million predictions. It is a major AI-for-science result, not a universal solution to structural biology.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=alphafold"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#work-jumper-alphafold2-2021"}],"tree:recordType":"atlasEntry","tree:startYear":2020,"tree:endYear":2020,"tree:dateLabel":"2020","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-science"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-f"},"tree:legacyClassificationCode":"f","tree:legacyClassificationLabel":"Foundational","tree:kind":"development","tree:significance":"foundational","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aalphafold%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aalphafold%3AmapStatus"}],"tree:landmarkWorkAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#work-link-alphafold%3Ejumper-alphafold2-2021"}],"tree:claimFingerprint":"39885a7b"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-proteinlm","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"proteinlm","schema:name":"Protein LMs & generative design","schema:description":"ESM language models and RFdiffusion: read protein space like text, then write new proteins into it. Design, not just prediction.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=proteinlm"},"tree:recordType":"atlasEntry","tree:startYear":2022,"tree:endYear":2022,"tree:dateLabel":"2022","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-science"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aproteinlm%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Aproteinlm%3AmapStatus"}],"tree:claimFingerprint":"4af6b38f"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-alphafold3","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"alphafold3","schema:name":"AlphaFold 3 & interactions","schema:description":"Complexes, DNA/RNA, ligands via diffusion. Drug-discovery pipelines re-tooled around learned structure.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=alphafold3"},"tree:recordType":"atlasEntry","tree:startYear":2024,"tree:endYear":2024,"tree:dateLabel":"2024","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-science"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:s