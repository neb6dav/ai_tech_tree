82a3-1c846701c866#node-federated","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"federated","schema:name":"Federated learning","schema:description":"Training across devices or organizations without centralizing their raw data. It is deployed in privacy-sensitive settings and remains an active research area in optimization, security, and heterogeneous clients.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=federated"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-1602.05629"}],"tree:recordType":"atlasEntry","tree:startYear":2017,"tree:endYear":2017,"tree:dateLabel":"2017","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-training"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Afederated%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Afederated%3AmapStatus"}],"tree:researchTier":"integrated","tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-federated%3E1602.05629"}],"tree:claimFingerprint":"33de5c64"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-dltheory","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"dltheory","schema:name":"Deep learning theory (NTK, double descent)","schema:description":"Why do overparameterized nets generalize? NTK, double descent, lottery tickets — insight-rich, prediction-poor. Theory still trails practice by years.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=dltheory"},"tree:recordType":"atlasEntry","tree:startYear":2019,"tree:endYear":2019,"tree:dateLabel":"2019","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-training"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-a"},"tree:legacyClassificationCode":"a","tree:legacyClassificationLabel":"Active","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"active","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Adltheory%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Adltheory%3AmapStatus"}],"tree:claimFingerprint":"abe229ce"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-gap_memory","@type":["schema:DefinedTerm","prov:Entity","tree:OpenResearchDirection"],"schema:identifier":"gap_memory","schema:name":"Sleep & memory consolidation","schema:description":"Research direction: develop principled offline consolidation that transfers episodic experience into durable behavior without destructive forgetting. Long context and external memory address related but different problems.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=gap_memory"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2310.06762"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-2606.08447"}],"tree:recordType":"atlasEntry","tree:startYear":2026,"tree:endYear":2026,"tree:dateLabel":"2026","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-training"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-g"},"tree:legacyClassificationCode":"g","tree:legacyClassificationLabel":"Open direction","tree:kind":"open_direction","tree:significance":"not_assessed","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_memory%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Agap_memory%3AmapStatus"}],"tree:researchQuestion":["Can episodic experience be consolidated into durable parametric behavior while bounding forgetting and outperforming long-context, retrieval, and rehearsal controls?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_memory%3E2310.06762"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-gap_memory%3E2606.08447"}],"tree:claimFingerprint":"3fcb611c","tree:directionClaimState":"editorial_hypothesis","tree:directionAsOf":"2026-08-04","tree:directionConfidence":"high","tree:closureCriteria":"Across a long ordered experience stream, demonstrate retained prior-task performance, positive transfer, and stable general capability while beating matched replay-buffer, rehearsal, retrieval, long-context, and parameter-expansion controls at equal storage and compute.","tree:partialResult":["TRACE exposes severe capability and instruction-following degradation during sequential LLM adaptation.","Delayed sleep-inspired replay can partially restore multiple sequentially learned tasks.","Replay, regularization, adapters, and dynamic expansion mitigate forgetting but do not establish general durable consolidation."],"tree:starterProject":["Individual: Compare delayed generative replay, immediate rehearsal, and LoRA isolation on a small TRACE stream with explicit storage and compute accounting.","Small lab: Consolidate episodic traces into a 7B model and compare parametric retention against retrieval, long context, and equal-size raw replay buffers.","Well-funded lab: Run a months-long multimodal experience stream with periodic consolidation, measuring forgetting, transfer, behavior drift, and retained safety properties."],"tree:counterexample":["Reasoning-augmented continual learning reduces some forgetting on TRACE.","Sleep-inspired replay partially restores prior tasks after multiple sequential updates.","Titans provides test-time neural memory but is not equivalent to offline parametric consolidation.","Long context and retrieval can preserve access to episodes without consolidating them into durable behavior."],"tree:crowdedness":"High in continual learning; lower in biologically inspired offline consolidation at LLM scale.","tree:tractability":"Medium for 1B-7B studies and low for frontier-scale long-horizon consolidation.","tree:noveltyReview":{"@value":{"status":"targeted_search","checkedAt":"2026-08-04","scope":"arXiv and official repositories for continual learning, catastrophic forgetting, generative replay, sleep-inspired consolidation, neural memory, and LLM adaptation.","note":"The field is crowded, but the targeted search did not find a frontier-scale system satisfying durable consolidation and matched external-memory controls."},"@type":"@json"},"tree:researchResources":{"@value":{"benchmarks":["TRACE","CLINC150","Split-CIFAR100","DomainNet","CLEAR","RULER or LongBench as external-memory controls"],"code":["https://github.com/ContinualAI/avalanche","https://github.com/aimagelab/mammoth","https://github.com/Wang-ML-Lab/llm-continual-learning-survey"],"datasets":["TRACE eight-task stream","CLINC150","Versioned domain corpora with frozen held-out evaluations"],"estimated":{"individual":"1 x 24-48 GB GPU with a 0.5B-3B model for 3-7 days","smallLab":"8 x 80 GB GPUs for 7B sequential runs over 2-4 weeks","wellFundedLab":"64-128 accelerators for 13B-70B long-horizon studies over 4-8 weeks or longer"}},"@type":"@json"}},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-mtgeorgetown","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"mtgeorgetown","schema:name":"Georgetown MT demo → ALPAC","schema:description":"Russian→English demo promised solved-in-5-years; the 1966 ALPAC report axed US funding. NLP's first boom-bust cycle, complete in twelve years.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=mtgeorgetown"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#work-ibm-georgetown-mt-1954"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#work-alpac-language-machines-1966"}],"tree:recordType":"atlasEntry","tree:startYear":1954,"tree:endYear":1966,"tree:dateLabel":"1954-1966","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-language"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-x"},"tree:legacyClassificationCode":"x","tree:legacyClassificationLabel":"Ended / superseded (legacy)","tree:kind":"development","tree:significance":"not_assessed","tree:activity":"not_assessed","tree:trajectory":"ambiguous_ended_or_superseded","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Amtgeorgetown%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Amtgeorgetown%3AmapStatus"}],"tree:landmarkWorkAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-