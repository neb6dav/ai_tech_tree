Status"}],"tree:researchTier":"integrated","tree:tag":["optimization","training"],"tree:researchQuestion":["Which optimizer behavior is actually responsible for robust scaling across architectures and data regimes?"],"tree:paperAssociation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-adam%3E1412.6980"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-link-adam%3E1711.05101"}],"tree:claimFingerprint":"ccd76249"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#node-batchnorm","@type":["schema:DefinedTerm","prov:Entity","tree:ResearchDevelopment"],"schema:identifier":"batchnorm","schema:name":"Batch normalization","schema:description":"Mini-batch statistics stabilized and accelerated deep-network training, becoming a standard ingredient in convolutional networks and the ResNet lineage.","schema:inDefinedTermSet":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866"},"schema:url":{"@id":"./#node=batchnorm"},"schema:citation":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#paper-arxiv-1502.03167"}],"tree:recordType":"atlasEntry","tree:startYear":2015,"tree:endYear":2015,"tree:dateLabel":"2015","tree:lane":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#lane-training"},"tree:legacyClassification":{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#classification-f"},"tree:legacyClassificationCode":"f","tree:legacyClassificationLabel":"Foundational","tree:kind":"development","tree:significance":"foundational","tree:activity":"not_assessed","tree:trajectory":"not_assessed","tree:statusAsOf":"2026-08-04","tree:statusConfidence":"low","tree:statusRationale":"Low-confidence editorial migration from the legacy category; unrepresented facets remain unassessed.","tree:evidenceAssessment":[{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Abatchnorm%3Adevelopment"},{"@id":"urn:uuid:7d0547f2-6239-5a56-82a3-1c846701c866#assessment-node%3Abatchnorm%3AmapStatus"}],"tree:researchTier":"integrated","tree:paperAs