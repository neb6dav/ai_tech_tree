{
  "schemaVersion": "1.0.0",
  "project": {
    "version": "1.1.0",
    "edition": "2026-08-21-stable-1",
    "releaseState": "Preview",
    "asOf": "2026-08-04",
    "scope": "A navigable atlas of selected AI research developments, their recorded relationships, and research directions from 1879 through 2026.",
    "canonicalUrl": "https://neb6dav.github.io/ai_tech_tree/",
    "repositoryUrl": "https://github.com/neb6dav/ai_tech_tree",
    "contributionGuideUrl": "https://github.com/neb6dav/ai_tech_tree/blob/main/CONTRIBUTING.md",
    "citationUrl": "./CITATION.cff",
    "manifestUrl": "./release-manifest.json",
    "inclusionCriteria": [
      "Historically influential concepts, systems or results",
      "Developments needed to make a major lineage legible",
      "Landmark papers, books, theses and reports that make a major lineage directly readable; selected 2010-2026 ArXiv work that fills a documented map gap",
      "Open directions framed with a falsifiable or decision-relevant closure test"
    ],
    "knownLimitations": [
      "Curated, not exhaustive or peer reviewed",
      "English-language and English-Wikipedia bias",
      "Selected rather than systematic literature coverage; landmark links prioritize stable, authoritative access",
      "Industrial work may be missing because results are private or poorly documented",
      "Priority and influence claims can be disputed",
      "Some ArXiv-sourced additions and extension relationships have no completed Wikipedia review; exact coverage is reported in the evidence summary",
      "A map terminal means only that this edition records no downstream link",
      "Network positions are generated from recorded associations; spatial proximity is not evidence of chronology, importance, similarity, consensus or causality"
    ],
    "authors": [
      "@neb6dav"
    ],
    "license": "https://creativecommons.org/licenses/by-sa/4.0/",
    "correctionsUrl": "https://github.com/neb6dav/ai_tech_tree/issues/new/choose",
    "changelog": [
      "Repaired the first-minute map orientation with a curated, display-only 24-node anchor set and 72-relationship spine.",
      "Exposed primary navigation across desktop and tablet layouts and added a compact mobile start chooser.",
      "Renamed reader-facing relationship controls to Connections and Related without changing URL compatibility.",
      "Simplified previews and reader-facing guidance while preserving the complete methodology under Help.",
      "Separated relationship meaning from evidence strength",
      "Separated significance, activity and trajectory facets",
      "Added reviewed ranges and disclosed nonlinear spacing",
      "Added structured cards for every open direction",
      "Added list view, visible-fit, empty-state recovery and modal focus containment",
      "Removed data-derived HTML injection sinks and added single-file security metadata",
      "Added synchronized JSON-LD, JSON and NDJSON knowledge-graph exports with stable identifiers.",
      "Reserved a branch-label rail, added scale-aware grouped overview markers, and removed the redundant footer statistics strip.",
      "Anchored composite developments by their start year, repaired the Markov chronology, and added a rights-labeled landmark-reading graph for canonical papers and books.",
      "Added a centered, versioned first-visit guide with an optional left dock, action-labeled theme switching, and verified two-theme contrast.",
      "Made the docked guide a reserved left column so branch, era, timeline, list, empty-state and map text remain unobscured.",
      "Added a deterministic, evidence-aware 2-D Network view with synchronized selection, filters, theme, trace and share state.",
      "Packaged the atlas as a collaborative public-beta repository with citation, licensing, correction and contribution workflows.",
      "Published stable Opportunity endpoints and root application record URLs with compatibility paths.",
      "Added an exact staged-build manifest and persistent repository and contribution access."
    ]
  },
